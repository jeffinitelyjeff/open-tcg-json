    "rulings": [
      {
        "answer": "Yes, as long as either a card with [Growlmon] or [Takato Matsuki] is among the cards revealed, you can add it to your hand.",
        "question": "This card’s effect reveals 4 cards. If the cards revealed only include either a card with [Growlmon] or [Takato Matsuki], can I still add a card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. This card's effect reads “Add 1 card [...] and 1 [Takato Matsuki] among them to your hand,” so you must add as many cards to your hand as possible. In this case, you must add both 1 card with [Growlmon], and 1 [Takato Matsuki] to your hand.",
        "question": "This card’s effect reveals 4 cards. If both a card with [Growlmon] and [Takato Matsuki] are among the cards revealed, can I choose to only add one of them to my hand, and place the remaining card at the bottom of my deck?",
        "reference": "[1]"
      }
    ]
