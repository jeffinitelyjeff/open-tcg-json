  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX2-044#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX2-044 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, cards revealed from the top of your deck aren't considered to be “trashed from your deck,” so this card’s effect doesn’t activate.",
        "question": "An effect that reads, “Reveal a card from your deck” reveals this card and trashes it. Does this card's “When this card is trashed from your deck” effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "It means the effect can be activated both [When Digivolving] and [When Attacking].  You can activate it as a [When Digivolving] effect when you digivolve this Digimon, then reactivate it as a [When Attacking] effect by attacking with this Digimon.",
        "question": "This card has an effect that activates at both [When Digivolving] and [When Attacking] timings. What does this mean, exactly?",
        "reference": "[1]"
      }
    ]
  },
