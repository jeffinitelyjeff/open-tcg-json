  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT5-112#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT5-112 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "If this card is flipped over as a Security Digimon, it's played in its owner's battle area without battling the attacking Digimon. Even if the attacking Digimon has lower DP than this card, no battle occurs, and the attacking Digimon is not deleted.",
        "question": "What does \"without battling\" in this card's [Security] effect mean?",
        "reference": "[1]"
      },
      {
        "answer": "After playing this Digimon, the remaining checks are performed.",
        "question": "This card is flipped over during a security check. If the attacking Digimon has extra security checks remaining from <Security Attack +>, what happens?",
        "reference": "[1]"
      },
      {
        "answer": "No, it can't.",
        "question": "Can this card's [When Digivolving] effect be used to delete a Digimon that digivolved from a Tamer?",
        "reference": "[1]"
      }
    ]
  },
