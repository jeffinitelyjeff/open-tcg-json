  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT5-111#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT5-111 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't digivolve from a Digimon in your breeding area that has [Omnimon] using this card's effect.",
        "question": "Can I digivolve into this card from a Digimon in my breeding area that has [Omnimon]?",
        "reference": "[1]"
      },
      {
        "answer": "The target of attack is no longer in play, so the attack ends without a battle.",
        "question": "I attack an opponent's Digimon with this Digimon, and use its [When Attacking] effect to delete the opposing Digimon. What happens to the attack?",
        "reference": "[1]"
      },
      {
        "answer": "No. You didn't delete the opponent's Digimon in battle, so ＜Piercing＞ doesn't activate.",
        "question": "I attack an opponent's Digimon with this Digimon, and use its [When Attacking] effect to delete the opposing Digimon. If this Digimon has ＜Piercing＞, can I check the opponent's security cards?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can. If you do, the blocking Digimon will battle this Digimon.",
        "question": "My opponent attacks one of my Digimon with this Digimon, using its [When Attacking] effect to delete my Digimon. Can I use another Digimon with ＜Blocker＞ to block the attack?",
        "reference": "[1]"
      },
      {
        "answer": "No. This effect is activated at counter timing, which means it only activates after the [When Attacking] effect has finished activating.",
        "question": "My opponent's Digimon attacks. Can this card's [Opponent's Turn] effect be used to to end the attack before the attacking Digimon's [When Attacking] effect activates?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. The [On Deletion] effect activates immediately after the deletion occurs, so it activates before this card's [Opponent's Turn] effect.",
        "question": "My opponent's Digimon used a [When Attacking] effect to delete one of my Digimon with an [On Deletion] effect. If I use this card's [Opponent's Turn] effect to end the attack, does the [On Deletion] effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "My opponent attacks with a Digimon. After activating my [BT1-082 Rosemon]'s effect, can I use this card's [Opponent's Turn] effect to end the attack?",
        "reference": "[1]"
      },
      {
        "answer": "No. The battle has already concluded, which means the counter timing window for activating the effect has passed, so you can't activate this effect.",
        "question": "My opponent attacks with a Digimon. After comparing DP in battle, can I activate this card's [Opponent's Turn] effect to end the attack?",
        "reference": "[1]"
      },
      {
        "answer": "No. [When Attacking] effects will activate as normal.",
        "question": "If I use this card's [Opponent's Turn] effect, will the game treat the attack as if it never occurred?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I digivolve one of my Digimon with [Omnimon] in the battle area into this card in the hand when an effect to digivolve one of my Digimon is activated?",
        "reference": "[1]"
      }
    ]
  },
