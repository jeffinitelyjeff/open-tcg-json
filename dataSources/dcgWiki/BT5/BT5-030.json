  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT5-030#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT5-030 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Battle occurs as normal. This card's effect essentially means \"this Digimon can't be chosen as a target of attack by your opponent,\" which means that if you block with this Digimon, the target of attack can still be switched to this Digimon.",
        "question": "This Digimon gains ＜Blocker＞ by an effect. If I block with this Digimon in response to an opponent's attack, what happens?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.",
        "question": "My opponent has this Digimon in play. Can I use [BT4-090 Chaosmon]'s [When Digivolving] effect to attack it?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can. If your opponent uses [Blastmon]'s effect to switch the target of attack, a battle occurs as if this Digimon was attacked normally.",
        "question": "I have this Digimon in play, unsuspended, when my opponent attacks with [BT4-075 Blastmon]. Can [Blastmon]'s effect be used to switch the target of attack to this Digimon?",
        "reference": "[1]"
      }
    ]
  },
