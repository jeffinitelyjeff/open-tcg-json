    "rulings": [
      {
        "answer": "No, digivolving Digimon in your breeding area doesn't trigger the effect that reduces digivolution cost by 1.",
        "question": "I digivolve a Digimon in my breeding area into a Digimon card with [Greymon], [Garurumon] or [Omnimon] in its name. Can I use this Tamer's effect to reduce the digivolution cost by 1?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, each copy of this Tamer may be be suspended to reduce the digivolution cost by 1 each.",
        "question": "Does the second effect of this Tamer stack if there are multiple copies in play in my battle area?",
        "reference": "[1]"
      },
      {
        "answer": "No, [ST5-04 ToyAgumon] is not named [Agumon] or [Gabumon]. The effect to play a Digimon does not have \"in its name\" in the card text.",
        "question": "Can I play [ToyAgumon] or [Agumon Expert] with this card's [On Play] effect?",
        "reference": "[2]"
      },
      {
        "answer": "This card is meant to have a [Your Turn] effect.",
        "question": "This card's printing in BT-05: Booster Battle Of Omni has [Main] as its effect and its RB-01: Reboot Booster Rising Wind printing uses [Your Turn]. Which version is correct?",
        "reference": "[3]"
      }
    ]
  },
