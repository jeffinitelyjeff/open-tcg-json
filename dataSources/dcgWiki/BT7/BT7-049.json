    "rulings": [
      {
        "answer": "No. It is too late to trigger those [When Attacking] effects because it did not have them when the attack was declared.",
        "question": "I digivolve into a green level 6 Digimon with this card's [When Attacking] effect. Can I activate that Digimon’s [When Attacking] effects?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, the effect is mandatory. You reveal as many cards as you can, up to 3.",
        "question": "When attacking, do I have to reveal 3 cards from my deck with this card’s [When Attacking] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No. The effect reads, “You may digivolve,” so you can choose not to.",
        "question": "If a green level 6 Digimon card is among the cards revealed with this card’s [When Attacking] effect, do I have to digivolve into it?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can digivolve into the Digimon of your choosing.",
        "question": "If 2 or more green level 6 Digimon cards are among the cards revealed with this card’s [When Attacking] effect, can I choose either card to digivolve into?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you do.",
        "question": "When digivolving with this card’s [When Attacking] effect, do I draw a card as a digivolution bonus?",
        "reference": "[1]"
      }
    ]
