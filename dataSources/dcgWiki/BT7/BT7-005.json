  "image": "https://static.wikia.nocookie.net/digimoncardgame/images/1/14/BT7-005.png/revision/latest?cb=20220218130539",
  "inheritedEffect": "[Your Turn] [Once Per Turn] When one of your effects places a digivolution card under this Digimon, ＜Draw 1＞ (Draw 1 card from your deck.)",
  "level": "2",
  "name": "Dorimon",
  "nameJapanese": "ドリモン",
  "rarity": "Uncommon",
  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT7-005#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT7-005 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. When a Digimon digivolves, even if it happens due to an effect, it is not counted as an effect placing digivolution cards under that Digimon.",
        "question": "When one of my effects digivolves a Digimon with this card in its digivolution cards, does this card’s inherited effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No. Even if multiple cards are added to the Digimon’s digivolution cards, if they were added by a single effect, you only draw 1 card.",
        "question": "If one of my effects places 2 or more cards at the same time under a Digimon that has this card's inherited effect, can I draw that many cards?",
        "reference": "[1]"
      }
    ]
  },
