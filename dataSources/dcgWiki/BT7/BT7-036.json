  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT7-036#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT7-036 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, Tamer cards' [Security] effects aren't inherited effects. Some Tamer cards do have inherited effects, and those can be activated when such cards are placed in digivolution cards.",
        "question": "When this Digimon digivolves onto a Tamer card, does the Tamer card’s [Security] effect become an inherited effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Instead of a Tamer card, can I digivolve this card onto a level 3 Digimon that meets the digivolution requirements?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it is.  However, if the effect specifies Digimon cards, Digi-Egg cards, or any other type of card that isn't a Tamer card, it can't be targeted by that effect.",
        "question": "After a Tamer card ends up in this Digimon's digivolution cards, is that card affected by effects that trash digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you do. Even if you digivolve using a Tamer card, make sure to draw 1 card as the digivolution bonus.",
        "question": "If I digivolve this card on top of a Tamer card, do I still get the digivolution bonus?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. Digivolution doesn't count as “playing” a card, so you can attack that turn.",
        "question": "Can I attack the turn I digivolve this card on top of a Tamer card?",
        "reference": "[1]"
      },
      {
        "answer": "No. Since it's the first turn the Tamer was played, the limitation for attacking on the first turn a card is played still applies.",
        "question": "I play a Tamer card, then digivolve it into this Digimon. Can I then attack with that Digimon during that same turn?",
        "reference": "[1]"
      },
      {
        "answer": "It’s trashed.",
        "question": "If I've digivolved this card on top of a Tamer card and the Digimon is deleted, what happens to the Tamer card?",
        "reference": "[1]"
      }
    ]
  },
