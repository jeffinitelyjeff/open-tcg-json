  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT7-056#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT7-056 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes. Even if you revealed only a card with [X Antibody] in its traits or [Kota Domoto], you still add that card to your hand.",
        "question": "I reveal 3 cards with this card's [On Play] effect. If the cards revealed only include either a card with [X Antibody] in its traits or [Kota Domoto], can I still add a card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. When a Digimon digivolves, even if it happens due to an effect, it is not counted as an effect placing digivolution cards under that Digimon.",
        "question": "When one of my effects digivolves a Digimon with this card in its digivolution cards, does this card’s inherited effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No. Even if multiple cards are added to the Digimon’s digivolution cards, you only gain 1 memory.",
        "question": "f one of my effects places 2 or more cards at the same time under a Digimon that has this card's inherited effect, do I gain that much memory?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates.  This card's inherited effect is a [Your Turn] effect, so it can be activated when this card becomes a digivolution card under a Digimon in the battle area. Therefore, when this card itself is added, the effect is triggered as an inherited effect.",
        "question": "When this card is placed in one of my Digimon’s digivolution cards, does this card’s inherited effect activate?",
        "reference": "[1]"
      }
    ]
  },
