  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX7-049#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX7-049 (Sep. 13, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, they can digivolve it.  Digimon that aren't affected by effects aren't affected by this card's [When Digivolving] effect.",
        "question": "Can my opponent digivolve a level 4 or lower Digimon that isn't affected by effects in the battle area during their next turn after this card's [When Digivolving] effect has activated?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, they can digivolve it.  This card's [When Digivolving] effect only affects your opponent's level 4 or lower Digimon in the battle area. It doesn't affect Digimon in the breeding area.",
        "question": "Can my opponent digivolve a level 4 or lower Digimon in the breeding area during their next turn after this card's [When Digivolving] effect has activated?",
        "reference": "[1]"
      },
      {
        "answer": "No, they can't digivolve it.  This card's [When Digivolving] effect also affects Digimon that were played after it activated.",
        "question": "Can my opponent digivolve a level 4 or lower Digimon that was played after this card's [When Digivolving] effect has activated?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't place it for that DigiXros.  You declare the DigiXros at the same time as when you choose the cards to place for the DigiXros. Once placed, additional cards to place can't be chosen.",
        "question": "I activated this card's [All Turns] effect when this card in the battle area was placed for a DigiXros. Can I place the card that was played by this [All Turns] effect for that DigiXros?",
        "reference": "[1]"
      }
    ]
  },
