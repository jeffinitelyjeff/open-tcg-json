  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX7-014#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX7-014 (Sep. 13, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Your opponent can't play Digimon with 6000 DP or less, and they can't move Digimon with 6000 DP or less.",
        "question": "Does this card's [When Digivolving] effect prevent my opponent from playing or moving any Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.  This card's [When Digivolving] effect prevents your opponent from playing or moving Digimon with 6000 DP or less. EX5-058 [Octomon]'s [On Play] [When Digivolving] effect is an effect where you play a token, therefore you aren't prevented from playing it.",
        "question": "During a turn when this card's [When Digivolving] effect has activated, can I use EX5-058 [Octomon]'s [On Play] [When Digivolving] effect to play a [Fujitsumon] Token into my opponent's battle area?",
        "reference": "[1]"
      },
      {
        "answer": "No, it can't be moved.  This card's [When Digivolving] effect also prevents effects from moving Digimon.",
        "question": "Can my opponent use P-143 [Drimogemon]'s [End of Your Turn] effect to move it from the battle area to the breeding area during their next turn after this card's [When Digivolving] effect has activated?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't place it for that DigiXros.  You declare the DigiXros at the same time as when you choose the cards to place for the DigiXros. Once placed, additional cards to place can't be chosen.",
        "question": "I activated this card's [All Turns] effect when this card in the battle area was placed for a DigiXros. Can I place the card that was played by this [All Turns] effect for that DigiXros?",
        "reference": "[1]"
      }
    ]
  },
