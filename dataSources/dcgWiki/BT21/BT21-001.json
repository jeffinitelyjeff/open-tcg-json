  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT21-001#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT21-001 (Apr. 4, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "The [Security] effect will activate first.Upon a security check, a [Security] effect will immediately activate without pending activation.",
        "question": "What order do an effect that triggers when a card is removed from a security stack and a [Security] effect on a checked card activate when they trigger simultaneously upon a security check?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, another security check is performed.",
        "question": "A Digimon that has this card in its digivolution cards attacks, and a security check was performed on my opponent's security stack.If the attacking Digimon with this card in its digivolution cards digivolves into a Digimon with ＜Security A. +1＞ (This Digimon checks 1 additional security card.) using this card's inherited effect, is another security check performed?",
        "reference": "[1]"
      },
      {
        "answer": "The top card of the security stack.Upon a security check, the checked card is already considered to be removed from the security stack, therefore that card won't be trashed.",
        "question": "I use a Digimon that has this card in its digivolution cards to perform a security check on my opponent's security stack, then I use this Digimon's inherited effect to digivolve into BT21-024 [Cyberdramon]. What card is trashed by BT21-024 [Cyberdramon]'s [When Digivolving] effect at such times?",
        "reference": "[1]"
      }
    ]
  },
