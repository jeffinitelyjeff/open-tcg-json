  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT21-029#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT21-029 (Apr. 4, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "The [Security] effect will activate first.Upon a security check, a [Security] effect will immediately activate without pending activation.",
        "question": "What order do an effect that triggers when a card is removed from a security stack and a [Security] effect on a checked card activate when they trigger simultaneously upon a security check?",
        "reference": "[1]"
      },
      {
        "answer": "The token of the player that activated this card's [All Turns] effect is played as an opponent's Digimon.At the end of the game, that token is returned to its owner.",
        "question": "Which player's token does this card's [All Turns] effect play as an opponent's Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.This card's [All Turns] effect plays one of your cards.Cards can be played by your effects even after a \"your opponent can't play Digimon by effects\" effect has activated.",
        "question": "Can I use this card's [All Turns] effect to play a [Petrification] Token. (Digimon/White/3000 DP/[Your Turn] This Digimon can't suspend. [On Deletion] Trash your top security card.) during the turn I activated BT8-097 [Crimson Blaze]'s [Main] effect?",
        "reference": "[1]"
      }
    ]
  },
