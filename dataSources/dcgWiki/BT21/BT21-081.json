  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT21-081#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT21-081 (Apr. 4, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't.The Digimon that was given ＜Piercing＞ (When this Digimon deletes your opponent's Digimon in battle while attacking, it checks security before the attack ends.) by this effect must attack if possible.",
        "question": "Can I use this card's [End of Your Turn] effect to give ＜Piercing＞ (When this Digimon deletes your opponent's Digimon in battle while attacking, it checks security before the attack ends.) to 1 of my Digimon, but then choose to not attack with that Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, an attack using the 2nd effect isn't possible. A new attack declaration can't be made during an attack.In this case, the [End of Your Turn] effects on both copies of this card trigger simultaneously at the end of your turn, and you use the [End of Your Turn] effect on the 1st copy of this card to attack.The 2nd [End of Your Turn] effect can be activated before the counter timing, but because you can't declare another attack during an attack, you won't be able to attack using the 2nd effect, even if you activate it.",
        "question": "I have 2 copies of this card in the battle area.At the end of my turn, I used the [End of Your Turn] effect on the 1st copy of this card to attack. Can I then use the [End of Your Turn] effect on the 2nd copy of this card to attack?",
        "reference": "[1]"
      }
    ]
  },
