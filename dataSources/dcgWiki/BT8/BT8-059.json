  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT8-059#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT8-059 (Mar. 28, 2024)"
      },
      {
        "link": "https://digimoncard.com/rule/?card_no=BT8-059#qaResult_card",
        "num": 2,
        "text": "Official JP Q&A for BT8-059 (2024/09/20, translated by DeepL)"
      }
    ],
    "rulings": [
      {
        "answer": "This effect prevents all players from digivolving with effects that say \"ignoring digivolution requirements\" or otherwise digivolving from Digimon without meeting digivolution requirements.",
        "question": "How does this card’s effect work, exactly?",
        "reference": "[1]"
      },
      {
        "answer": "No. Those effects don't mention “ignoring digivolution requirements,” and require you to follow the specified digivolution requirements when digivolving a Tamer as if they were a Digimon.",
        "question": "Does this card's effect also prevent the effects on [Hybrid] cards like \"You may digivolve this card from your hand onto one of your red Tamers as if the Tamer is a level 3 red Digimon\"?",
        "reference": "[1]"
      },
      {
        "answer": "No. DNA and special digivolutions are treated as a card’s digivolution requirements, so you can still perform both as normal.",
        "question": "Does this card’s effect prevent DNA and special digivolutions?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. The effect doesn't ignore digivolution requirements―it just lets you skip paying the memory cost―so you can activate it as normal.",
        "question": "If this Digimon is in play, can I activate an effect that reads, “you may digivolve...without paying its memory cost”?",
        "reference": "[1]"
      },
      {
        "answer": "This effect prevents digivolves from ignoring digivolution requirements. This effect affects both players.",
        "question": "What is the effect of \"neither party can ignore digivolution requirements?\"",
        "reference": "[2]"
      },
      {
        "answer": "Yes, it can be DNA digivolves or burst digivolutions.",
        "question": "Can I DNA digivolve or burst digivolve while the \"neither of us can ignore the digivolution requirements\" effect is active?",
        "reference": "[2]"
      },
      {
        "answer": "Yes, it can digivolve. If you digivolve without paying the cost, you are not ignoring the digivolution requirements.",
        "question": "Can I digivolve without paying the cost while the \"each other can't ignore digivolution requirements\" effect is active?",
        "reference": "[2]"
      },
      {
        "answer": "No, you cannot ignore any part of the digivolution requirements to digivolve.",
        "question": "While the \"Mutual cannot ignore digivolution requirements\" effect is activated, can I ignore some of the digivolution requirements, such as the \"Ignore Lv.",
        "reference": "[2]"
      },
      {
        "answer": "No, it cannot digivolve.",
        "question": "Can I use the [When Attacking] effect of \"BT10-067 Justimon: Critical Arm\" to digivolve it while the \"Mutually cannot ignore digivolution requirements\" effect is activated?",
        "reference": "[2]"
      },
      {
        "answer": "Yes, it can digivolve. The effect of digivolving a card with additional information is not an effect that ignores the digivolution requirements.",
        "question": "Can I use the first effect of BT4-011 Agunimon to digivolve from tamers while the \"Mutually cannot ignore digivolution requirements\" effect is activated?",
        "reference": "[2]"
      }
    ]
  },
