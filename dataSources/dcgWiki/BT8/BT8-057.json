    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT8-057#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT8-057 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. You already used the Option cards and activated their effects, so this card’s [Opponent's Turn] effect can’t negate them.",
        "question": "My opponent has this Digimon in play. During my turn, I use an Option card like [BT1-109 Smashed Potatoes] or [EX1-071 Win Rate: 60%!] which has an effect that activates “the next time one of your Digimon digivolves”. After that, all of my opponent’s Digimon become suspended.  If I then digivolve one of my Digimon, are the effects from the Option cards I used earlier negated?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.  Activating ＜Delay＞ on Option cards that are already in your battle area doesn't count as using an Option card.",
        "question": "My opponent has this Digimon in play. If I have an Option card with ＜Delay＞ that I used from my hand earlier, can I activate its ＜Delay＞ effect?",
        "reference": "[1]"
      }
    ]
  },
