  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT2-034#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT2-034 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. Even if both Digimon are deleted simultaneously, the effects activate one at a time. When the first Salamon's effect activates, you add 1 card to your security stack, bringing the total up to 4. This means the \"3 cards or less\" condition for the second Salamon's effect no longer applies. The second Salamon's effect doesn't activate, and your security stack remains at 4 cards.",
        "question": "I have 3 cards in my security stack when 2 copies of this Digimon are deleted at the same time. Do the [On Deletion] effects on both cards activate, bringing my security stack up to 5 cards?",
        "reference": "[1]"
      }
    ]
  },
