  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT2-112#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT2-112 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "It refers strictly to your opponent's Digimon with the highest DP they control. The effect doesn't check the DP of your Digimon.",
        "question": "This card's [When Attacking] effect refers to \"your opponent's Digimon with the highest DP.\" Does this strictly refer to my opponent's Digimon with the highest DP, or does it refer to when I attack an opponent's Digimon with the highest DP out of all Digimon in play, including my own?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. If your opponent has multiple Digimon tied for highest DP, attacking any of them allows you to unsuspend this Digimon.",
        "question": "My opponent has multiple Digimon tied for highest DP. If I attack any one of them, does this card's [When Attacking] effect let me unsuspend this Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, this Digimon's [When Attacking] effect only lets you unsuspend this Digimon when attacking your opponent's Digimon with the highest DP, regardless of whether it's suspended or not.",
        "question": "My opponent's Digimon with the highest DP is unsuspended. If I attack their unsuspended Digimon with the highest DP, can I unsuspend this Digimon?",
        "reference": "[1]"
      }
    ]
  },
