    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT2-049#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT2-049 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. The Digimon suspended by this effect -- along with all of your opponent's other suspended Digimon -- remain suspended during their unsuspend phase.",
        "question": "I use this card's [On Play] effect to suspend an opponent's Digimon. Is that Digimon the only one that doesn't unsuspend during my opponent's next unsuspend phase?",
        "reference": "[1]"
      },
      {
        "answer": "No. It only prevents suspended Digimon from unsuspending. Any unsuspended Digimon remain that way.",
        "question": "Does this card's [On Play] effect cause my opponent's unsuspended Digimon to suspend themselves during their next unsuspend phase?",
        "reference": "[1]"
      },
      {
        "answer": "No, the effect doesn't affect Tamers. They unsuspend as normal.",
        "question": "Does this card's [On Play] effect prevent my opponent's suspended Tamers from unsuspending during their next unsuspend phase?",
        "reference": "[1]"
      }
    ]
  },
