      }
    ],
    "rulings": [
      {
        "answer": "No, this card's ＜Delay＞ effect does not allow ignoring digivolution requirements, so you can only digivolve into a card that meets the digivolution requirements.",
        "question": "When I use this card's ＜Delay＞ effect to digivolve into a card in my hand, can it digivolve regardless of its digivolution requirements?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't burst digivolve or DNA digivolve.",
        "question": "Can I use this card's ＜Delay＞ effect to burst digivolve or DNA digivolve into a card in my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  This card's ＜Delay＞ effect digivolves 1 Digimon. It doesn't digivolve Tamers.",
        "question": "Can I use this card's ＜Delay＞ effect to digivolve a Tamer into a Digimon card with a \"your Tamer is treated as a Digimon and can digivolve\" effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I activate this card's ＜Delay＞ effect but choose to not digivolve?",
        "reference": "[1]"
      }
    ]
  },
