  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=P-123#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for P-123 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it does. You gain 1 memory when one of your Digimon moves from the breeding area to the battle area, regardless of whether or not you hatch in your breeding area.",
        "question": "Does this card's [Your Turn] effect give me 1 memory when one of my Digimon moves from the breeding area to the battle area, even if I don't hatch in my breeding area?",
        "reference": "[1]"
      },
      {
        "answer": "It occurs during the breeding phase. If effects trigger during the breeding phase, the main phase will come after all effects have activated.",
        "question": "When one of my Digimon moves from the breeding area to the battle area during the breeding phase, does the hatching in the breeding area and gaining 1 memory for this card's [Your Turn] effect occur during the breeding phase or main phase?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates.",
        "question": "I moved a Digimon from the breeding area to the battle area when this card was in my battle area and all of my Digimon's DP was reduced by activation of an effect. If that Digimon's DP becomes 0 due to the DP-reducing effect at the same time it's moved to the battle area, then it's deleted, does this card's [Your Turn] effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates.",
        "question": "Does this card's [Your Turn] effect activate when this Digimon itself moves from the breeding area to the battle area?",
        "reference": "[1]"
      }
    ]
  },
