  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=P-033#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for P-033 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes. This Digimon's effect becomes active as soon as your black Digimon reaches 13000 DP or more. Your black Digimon will conduct its battle with ＜Piercing＞.",
        "question": "I have this Digimon in play, and attack with a black Digimon with 12000 DP, whose [When Attacking] effect grants itself +1000 DP, bringing its total DP up to 13000. Does this Digimon's effect allow that black Digimon to have ＜Piercing＞ during the battle?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. This Digimon's inherited effect becomes active as soon as your black Digimon reaches 13000 DP or more. Your black Digimon will conduct its battle with ＜Security A. +1＞.",
        "question": "I attack with a black Digimon with 12000 DP, whose [When Attacking] effect grants itself +1000 DP, bringing its total DP up to 13000. If this Digimon is in its digivolution cards, does this Digimon's inherited effect allow the black Digimon to have ＜Security A. +1＞ during its battle?",
        "reference": "[1]"
      },
      {
        "answer": "This card's inherited effect is a [Your Turn] effect, so your black Digimon will lose ＜Security A. +1＞ as soon as it drops below 13000 DP. If the Digimon has no other effects to increase the number of security checks, the attack will end without performing any further checks.",
        "question": "This card is in the digivolution cards of a black Digimon with 13000 DP, which I use to attack my opponent. The first card flipped over during the security check causes the black Digimon to ＜De-Digivolve  nocategory＞ (Trash up to nocategory cards from the top. You can't trash past level 3 cards.), resulting in it having 12000 DP or less. Does the black Digimon still get extra security checks from ＜Security A. +1＞?",
        "reference": "[1]"
      }
    ]
  },
