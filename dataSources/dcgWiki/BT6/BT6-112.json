  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT6-112#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT6-112 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can’t ignore its color requirements.",
        "question": "When using this card’s [On Play] effect to use an Option card, can I use any 7-cost Option card, regardless of its color requirements?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can’t. Since those options are cards that have effects that “reduce the cost by…” or “its memory cost is equal to…” when they would be used, their cost has not actually changed when activating this card’s [On Play] effect, so they can’t be used with this card’s effect. However, since [BT2-099 Glorious Burst] always has the effect of reducing its use cost when used from the hand, if you have 2 yellow Tamers, it can be used with this card’s effect as its use cost will be 7.",
        "question": "Can I use option cards that can change their cost to 7 on certain conditions such as [BT7-100 Qualialise Blast] or [BT11-108 DG Dimension] with this card’s [On Play] effect?",
        "reference": "[1]"
      }
    ]
  },
