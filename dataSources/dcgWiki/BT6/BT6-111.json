  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT6-111#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT6-111 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it activates at the end of the battle, regardless of outcome.",
        "question": "Does this card’s [Security] effect activate even if it loses the battle against the attacking Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Even after using this card’s [Security] effect to prevent your opponent’s Digimon from attacking players, it only prevents them from declaring further attacks. The current attack proceeds normally.",
        "question": "If I use this card’s [Security] effect to prevent my opponent’s currently attacking Digimon from attacking players, does the attack end immediately, or does my opponent get to perform their remaining security checks?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you do.",
        "question": "My opponent uses this card’s [Security] effect to prevent one of my Digimon with ＜Piercing＞ from attacking players. If that Digimon attacks and deletes an opponent's Digimon and survives, do I still get to perform security checks with ＜Piercing＞?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can.  This card’s [Security Effect] only affects Digimon that are in play at the time it’s activated.",
        "question": "I have 11 or fewer Digimon in play, and my opponent activates this card’s [Security] effect, preventing all of my Digimon from attacking players for the turn. If I later play a Digimon with ＜Rush＞ during that same turn, can that Digimon attack players?",
        "reference": "[1]"
      },
      {
        "answer": "No, it doesn’t.",
        "question": "If this Digimon attacks and is deleted in battle, does its [End of Attack] effect activate at the end of the attack?",
        "reference": "[1]"
      }
    ]
  },
