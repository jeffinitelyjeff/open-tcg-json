      }
    ],
    "rulings": [
      {
        "answer": "Yes, the effect reads \"By placing this Digimon under 1 of your other Digimon [...] as its bottom digivolution card,\" so you may also choose to not place it as the bottom digivolution card. In such cases, it remains in the battle area as a Digimon like normal.",
        "question": "Can I choose to not activate this card's [On Play] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, the effect reads \"you may play it,\" so you may also choose to not play it. In such cases, you add it to your hand like any other card.",
        "question": "When I reveal a card with the [Legend-Arms] trait and a play cost of 7 or less from my deck for this card's [On Play] effect, can I choose to not play that card?",
        "reference": "[1]"
      },
      {
        "answer": "It can't be played due to [BT9-047 Pomumon]'s effect, so you add it to your hand like any other card.",
        "question": "I revealed a card with the [Legend-Arms] trait and a play cost of 7 or less from my deck for this card's [On Play] effect] when I had a [BT9-047 Pomumon]. What happens to that card?",
        "reference": "[1]"
      }
    ]
