  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT19-053#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT19-053 (Nov. 1, 2024)"
      },
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT19-053#qaResult_card",
        "num": 2,
        "text": "Official English Q&A for BT19-053 (Jan. 10, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can.",
        "question": "If I use this card's [When Attacking] effect to play a Digimon when this card attacks, can I suspend the played Digimon using this card's ＜Alliance＞?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it triggers.",
        "question": "Does this card's [All Turns] effect also trigger when this card itself would leave the battle area other than in battle?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can place all of those Digimon face-up at the bottom of your security stack.  This card's [All Turns] effect affects all Digimon without having to choose them.",
        "question": "If I activate this card's [All Turns] effect when multiples of my Digimon with the [Royal Base] trait would leave the battle area at the same time, can I place all of those Digimon face-up at the bottom of my security stack?",
        "reference": "[1]"
      },
      {
        "answer": "They become face-up security cards that remain revealed.  Other than rules that specify face-up security cards, the rules apply in the same manner as standard security cards.",
        "question": "What happens to cards placed face up in the security stack by effects?",
        "reference": "[2]"
      },
      {
        "answer": "The check is performed with the card left revealed.  Other than rules for cards left revealed, the rules apply in the same manner as standard security checks.",
        "question": "What happens upon a security check for a security card that is placed face-up?",
        "reference": "[2]"
      },
      {
        "answer": "Yes, it triggers.",
        "question": "Does a card's [Security] effect trigger upon a security check with that card placed face-up?",
        "reference": "[2]"
      },
      {
        "answer": "Any face-up cards are placed face down, then you shuffle the cards.  After shuffling, all cards are left face-down.",
        "question": "What happens if I shuffle a security stack that includes security cards placed face-up?",
        "reference": "[2]"
      }
    ]
  },
