    ],
    "rulings": [
      {
        "answer": "If you attack with a Digimon that has this inherited effect while the effect is active, your opponent's Digimon can't change the target of the attack by blocking.",
        "question": "This card’s inherited effect reads, “This Digimon can't be blocked.” How does this effect work, exactly?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can.",
        "question": "I have a Digimon with [Imperialdramon] and this card in its digivolution cards. Can it attack an opponent’s suspended Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't. If your Digimon has the \"...can't be blocked\" effect, your opponent's Digimon can't block or suspend to block.",
        "question": "My opponent attacks with a Digimon with [Imperialdramon] and this card in its digivolution cards. Even though I can't block it, can I still try to block with my Digimon with ＜Blocker＞ just to suspend my Digimon?",
        "reference": "[1]"
      }
    ]
  },
