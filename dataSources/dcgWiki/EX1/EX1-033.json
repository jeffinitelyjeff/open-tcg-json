  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX1-033#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX1-033 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "When any one of your Digimon digivolves, as long as it meets the requirements, the memory cost of the digivolution is reduced by 1.",
        "question": "Does this card’s inherited effect reduce the digivolution costs of my other Digimon, or just the Digimon that has this card in its digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "No. As long as it’s the same turn, the effect will persist until you digivolve into a Digimon card with [Insectoid] or [Ancient Insect] in its traits.",
        "question": "I activate this card’s inherited effect, then digivolve into a Digimon without [Insectoid] or [Ancient Insect] in its traits. Does this waste the inherited effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. Reduce the digivolution cost by 1 for each time that Digimon attacked during the same turn. However, once you digivolve into a Digimon card that has [Insectoid] or [Ancient Insect] in its traits, the accumulated digivolution cost reductions from this effect will be reset.",
        "question": "If a Digimon with this card in its digivolution cards somehow attacks 2 or more times in the same turn, does the -1 digivolution cost reduction stack?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't reduce the memory cost of digivolutions performed in your breeding area with this card's inherited effect.",
        "question": "Can I reduce the memory cost of digivolutions in my breeding area with this card's inherited effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, it only reduces the memory cost by 1 when digivolving one of your Digimon into a Digimon card in your hand with [Insectoid] or [Ancient Insect].",
        "question": "If I digivolve a Digimon with [Insectoid] or [Ancient Insect] in my battle area into another Digimon, does this card’s inherited effect reduce the memory cost of that digivolution by 1?",
        "reference": "[1]"
      }
    ]
  },
