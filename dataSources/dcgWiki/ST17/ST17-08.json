  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=ST17-08#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for ST17-08 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it can.",
        "question": "Can this card's [When Digivolving] effect suspend 1 each of my opponent's Digimon and Tamers?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. Digivolutions from Tamers are also no longer possible.",
        "question": "Does this card's [When Digivolving] effect also prevent my opponent's Tamers from digivolving into Digimon cards in cases where Tamers can digivolve?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I activate the \"can't unsuspend or digivolve\" effect in this card's [When Digivolving] effect on opponent's Digimon/Tamers other than the ones suspended by this effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, it doesn't unsuspend.  The target Digimon is unaffected by this card's effect during the turn it activated, but the \"this Digimon isn't affected by the effects of your opponent’s Digimon until the end of your opponent's turn\" effect is lost when the turn switches, and then this card's effect prevents it from unsuspending.",
        "question": "If this card's [When Digivolving] effect is activated for an opponent's suspended Digimon with a \"this Digimon isn't affected by the effects of your opponent’s Digimon until the end of your opponent's turn,\" does that Digimon unsuspend during my opponent's next turn?",
        "reference": "[1]"
      }
    ]
  },
