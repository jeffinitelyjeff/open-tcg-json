  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=ST3-08#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for ST3-08 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can.",
        "question": "Can I use this card's inherited effect to target one of my opponent's Digimon with 1000 DP or less and delete it?",
        "reference": "[1]"
      },
      {
        "answer": "No battle occurs, and the attack ends. If there are other effects to activate (When Attacking effects, etc.), the attack ends after activating them.",
        "question": "A Digimon with this card as a digivolution card attacks an opponent's Digimon, then that Digimon's DP is reduced to 0 and deleted by this card's inherited effect. What happens to the attack?",
        "reference": "[1]"
      },
      {
        "answer": "No, blocking can only be performed in the blocker timing that occurs after all [When Attacking] effects finish resolving. As such, once a block has been declared, the window for activating this card's inherited effect has already passed, so it can't be activated.",
        "question": "A Digimon with this card as a digivolution card attacks an opponent's Digimon, then the opponent blocks with a Digimon that has ＜Blocker＞. Can I use this card's inherited effect to reduce the DP of the blocking Digimon to 0 and delete it?",
        "reference": "[1]"
      }
    ]
  },
