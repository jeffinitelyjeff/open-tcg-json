      }
    ],
    "rulings": [
      {
        "answer": "The player that activated this effect chooses.",
        "question": "Which player chooses which of my opponent's security cards is trashed by this card's [When Digivolving][When Attacking] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can activate it. When a revealed card is trashed from the deck or security stack, it is not considered to be trashed from the deck or security stack, but it is considered that a card was removed from the security stack, so [BT4-097 Kari Kamiya]'s effect can be activated.",
        "question": "My security cards were revealed due to the [When Digivolving] effect of this opponent's card, and 1 of them was trashed. Can I treat this as \"when a card is removed from your security stack\" and activate [BT4-097 Kari Kamiya]'s effect?",
        "reference": "[1]"
      }
    ]
  },
