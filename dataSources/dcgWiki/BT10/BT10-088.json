  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT10-088#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT10-088 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "When you play a Digimon card with DigiXros requirements, normally you can only DigiXros with Digimon from your hand or battle area. However, this effect also allows you to DigiXros with Digimon cards placed under a Tamer.",
        "question": "What does this card's \"by suspending this Tamer, you may place cards from under your Tamers as digivolution cards for a DigiXros\" effect do, exactly?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it does.",
        "question": "Does this card's [Your Turn] effect also allow me to DigiXros with cards placed under a Tamer other than this Tamer?",
        "reference": "[1]"
      },
      {
        "answer": "No, it doesn't.",
        "question": "Does this card's [Your Turn] effect also allow me to DigiXros with the digivolution cards of a Digimon that digivolved from a Tamer?",
        "reference": "[1]"
      },
      {
        "answer": "No, this card's effect reads \"when you would play 1 Digimon with DigiXros requirements\", so if you play 2 or more Digimon cards at the same time, the effect cannot be activated.",
        "question": "If I play 2 or more Digimon cards with DigiXros requirements at the same time, can I activate this card's effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't. This card's effect can be activated when you would play 1 Digimon card with DigiXros requirements only.",
        "question": "If I play 1 Digimon card with DigiXros requirements and 1 card without DigiXros requirements at the same time, can I activate this card's effect?",
        "reference": "[1]"
      }
    ]
  },
