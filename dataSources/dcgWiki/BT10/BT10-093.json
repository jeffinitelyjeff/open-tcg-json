    ],
    "rulings": [
      {
        "answer": "Yes, it can.",
        "question": "If I play a Digimon and want to place cards under it with DigiXros, can this card's [Your Turn] effect also place purple cards from under my Tamers in that Digimon's digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "No, this card's effect reads \"when you would play 1 level 4 or higher Digimon with [Bagra Army] in one of its traits\", so if you play 2 or more Digimon cards at the same time, the effect cannot be activated.",
        "question": "If I play 2 or more level 4 Digimon cards with [Bagra Army] in its traits at the same time, can I activate this card's effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't. This card's effect can be activated when you would play 1 level 4 Digimon cards with [Bagra Army] in its traits only.",
        "question": "If I play 1 level 4 Digimon cards with [Bagra Army] in its traits and 1 Digimon card without it at the same time, can I activate this card's effect?",
        "reference": "[1]"
      }
    ]
  },
