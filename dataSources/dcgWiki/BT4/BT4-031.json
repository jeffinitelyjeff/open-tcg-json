  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-031#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-031 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can.  If your [EX2-007 Mother D-Reaper] is chosen as the target to return to the hand for this card's effect, it will ultimately be placed at the bottom of the Digi-Egg deck instead of the hand according to the rules, but it meets this card's \"return 1 of your other Digimon to its owner's hand\" condition. A card isn't actually added to the hand, therefore effects such as \"when a card is added to the hand\" don't trigger.",
        "question": "Can I use this card's effect to return my [EX2-007 Mother D-Reaper] from the battle area to the hand?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.  If your token is chosen as the target to return to the hand for this card's effect, it will ultimately be removed from the game instead of being returned to the hand according to the rules, but it meets this card's \"by returning 1 of your Digimon to the hand\" condition. A card isn't actually added to the hand, therefore effects such as \"when a card is added to the hand\" don't trigger.",
        "question": "Can I use this card's effect to return my token that was played as a Digimon from the battle area to the hand?",
        "reference": "[1]"
      }
    ]
  },
