    "rulings": [
      {
        "answer": "No. When a card is in any area other than your battle area, [Your Turn] effects do not apply. So this card is not treated as a yellow card and is treated only as a red card.",
        "question": "If this card is in my hand, deck, or trash and another copy is revealed in a security check, is this Digimon treated as a yellow card?",
        "reference": "[1]"
      },
      {
        "answer": "No. [Your Turn] effects do not apply in the breeding area, so this card is not treated as a yellow card and is treated only as a red card.",
        "question": "When this card is in the breeding area, can I digivolve a Digimon on top of it that requires a yellow Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No. When it is outside of the Battle Area, it does not activate the effect of [Your Turn], so it does not activate the effect of treating it as a yellow card, but only as a red card.",
        "question": "Does this Digimon treat this card as a yellow card when it is in hand, deck, trash, or when it is turned over by a check from security?",
        "reference": "[2]"
      },
      {
        "answer": "No, the [Your Turn] effect is not activated in the Breeding Area, so it is not treated as a Yellow card and cannot be evolved from a Yellow Digimon to a Digivolution-ready Digimon.",
        "question": "When this card is in the Breeding Area, can it evolve from a Yellow Digimon to a Digimon that can digivolve?",
        "reference": "[2]"
      },
      {
        "answer": "The card is either a \"Red tamer card with a play cost of 4 or less\" or a \"Yellow tamer card with a play cost of 4 or less\".",
        "question": "Which cards can be played by this card's [Main] effect?",
        "reference": "[3]"
      }
    ]
  },
