  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-088#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-088 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, it doesn't.",
        "question": "You use this card's [Opponent's Turn] effect to trash a card in your opponent's security stack. Does that card's [Security] effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "Your opponent chooses the 2 cards to trash from their hand.",
        "question": "Which player chooses the cards to trash from your opponent's hand with this card's [On Deletion] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, a card was removed from your security stack, so it activates.",
        "question": "While this Digimon is in my battle area, my opponent's Digimon checks my security stack and flips over [BT1-107 Holy Wave]. Its [Security] effect activates, adding a card to my security stack. I ended up with the same number of cards in my security stack, but does this card's [Opponent's Turn] effect still activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, they both activate, trashing 2 of your opponent's security cards.",
        "question": "I have 2 copies of this Digimon in my battle area when an opponent's Digimon does a security check, removing a card from my security stack. Do the [Opponent's Turn] effects on both copies activate, trashing 2 of my opponent's security cards?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "If my opponent uses a card like [BT2-020 Gallantmon] to trash a card in my security directly, can I activate this card's effect?",
        "reference": "[1]"
      }
    ]
  },
