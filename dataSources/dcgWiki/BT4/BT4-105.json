  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-105#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-105 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "It wasn't deleted, so [On Deletion] effects don't activate.",
        "question": "I use this card's effect to place a Digimon on top of my security stack. Does that Digimon's [On Deletion] effect(s) activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  If your [EX2-007 Mother D-Reaper] is chosen as the target to place in the security stack, according to the rules it will be placed at the bottom of the Digi-Egg deck instead of the security stack.  A card isn't actually added to the security stack, therefore effects such as \"when a card is added to the security stack\" don't trigger.",
        "question": "Can I use this card's effect to place my [EX2-007 Mother D-Reaper] on top of my security stack from the battle area?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  If your token is chosen as the target to place in the security stack, according to the rules it's removed from the game instead of being placed in the security stack.  A card isn't actually added to the security stack, therefore effects such as \"when a card is added to the security stack\" don't trigger.",
        "question": "Can I use this card's effect to place my token that was played as a Digimon on top of my security stack from the battle area?",
        "reference": "[1]"
      },
      {
        "answer": "No, they don’t trigger.",
        "question": "If I choose my [EX2-007 Mother D-Reaper] or token that is treated as a Digimon in the battle area as the target for this card's effect, it isn't placed in the security stack. In such cases, do \"when a card is removed from the security stack\" effects trigger because a card wasn't added to the security stack even though it normally should have been added?",
        "reference": "[1]"
      }
    ]
  },
  "securityEffect": "[Security] ＜Recovery +1 (Deck)＞ (Place the top card of your deck on top of your security stack.)",
