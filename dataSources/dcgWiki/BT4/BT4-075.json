  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-075#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-075 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "When this Digimon attacks, no matter what its target is, this effect allows your opponent to choose any of their unsuspended Digimon. If they do, this Digimon is forced to attack it instead.",
        "question": "What exactly does this card's [When Attacking] effect do?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you are.",
        "question": "When attacking with this card, am I required to announce the target of attack?",
        "reference": "[1]"
      },
      {
        "answer": "You can't announce that you're attacking an opponent's unsuspended Digimon, but your opponent can force this Digimon to attack one of their unsuspended Digimon if they choose to.",
        "question": "Can I use this card's [When Attacking] effect to attack my opponent's unsuspended Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, the player who is currently being attacked gets to decide whether or not to switch the target. If they choose not to, the attack proceeds as it was originally declared.",
        "question": "My opponent attacks with [BT4-075 Blastmon]. If I have an unsuspended Digimon in play, am I forced to switch the target of attack to it?",
        "reference": "[1]"
      }
    ]
  },
