    "rulings": [
      {
        "answer": "No, you don't.",
        "question": "When I digivolved into this card, my opponent had 3 or less cards in their hand. Do I still gain memory from the [When Digivolving] effect?",
        "reference": "[1]"
      },
      {
        "answer": "If you have a Digimon with this effect, your opponent's Digimon can't block against its attacks.",
        "question": "What exactly does \"this Digimon is unblockable\" mean?",
        "reference": "[1]"
      },
      {
        "answer": "No. Attacking suspended Digimon isn't blocking, so you can attack them.",
        "question": "Does \"this Digimon is unblockable\" mean this Digimon can't attack my opponent's suspended Digimon?",
        "reference": "[1]"
      }
    ]
  },
