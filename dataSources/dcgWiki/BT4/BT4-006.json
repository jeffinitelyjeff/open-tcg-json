    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-006#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-006 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. You lose this card's inherited effect when it is placed in the trash, so it can't activate.",
        "question": "I have 9 cards in my trash and a Digimon with this card as a digivolution card is deleted in battle. The deleted cards, including this one, are sent to my trash, and now I have over 10 cards in my trash. Does this card's ＜Retaliation＞  activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, if you had 10 or more cards when it was deleted, you can activate ＜Retaliation＞ .",
        "question": "I have 10 or more cards in my trash and a Digimon with this card as a digivolution card is deleted in battle. Before this card's effect has a chance to activate, another effect activates and reduces the number of cards in my trash to 9 or less. Does this card's ＜Retaliation＞  activate?",
        "reference": "[1]"
      }
    ]
  },
