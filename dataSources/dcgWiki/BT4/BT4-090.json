  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT4-090#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT4-090 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can. It doesn't become your opponent's turn until the attack ends or you declare that you're not making an attack.",
        "question": "I pay memory to digivolve into this Digimon. Can I use this card's [When Digivolving] effect to attack even though my memory gauge is now at 1 or greater on my opponent's side?",
        "reference": "[1]"
      },
      {
        "answer": "No, this effect doesn't ignore the ironclad rule that Digimon can't attack the turn they came into play, so you can't attack.",
        "question": "I play a Digimon, then digivolve into this card on the same turn. Can I attack with it?",
        "reference": "[1]"
      },
      {
        "answer": "No. You can activate this card's [When Digivolving] effect first and announce your attack, but you must activate all other effects before making the attack itself.",
        "question": "If I have other effects that activate on digivolution, can I attack before activating those effects after digivolving into this card?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.",
        "question": "Can I attack my opponent's unsuspended Digimon with this card when not attacking through its [When Digivolving] effect?",
        "reference": "[1]"
      }
    ]
  },
