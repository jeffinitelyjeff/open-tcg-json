  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=LM-027#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for LM-027 (Dec. 13, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, this card's [Main] effect does not allow ignoring digivolution requirements, so you can only digivolve into a card that meets the digivolution requirements.",
        "question": "When I use this card's [Main] effect to digivolve into a card in my hand, can it digivolve regardless of its digivolution requirements?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't burst digivolve or DNA digivolve.",
        "question": "Can I use this card's [Main] effect to burst digivolve or DNA digivolve into a card in my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  This card's [Main] effect digivolves 1 Digimon. It doesn't digivolve Tamers.",
        "question": "Can I use this card's [Main] effect to digivolve a Tamer into a Digimon card with a \"your Tamer is treated as a Digimon and can digivolve\" effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I activate this card's ＜Delay＞ effect if I don't have any red Digimon cards in my trash?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  You must perform \"return 1 red Digimon card from your trash to the top of the deck\" whenever possible.",
        "question": "Can I use this card's ＜Delay＞ effect to play a red Digimon card with 2000 DP or less from my trash without returning a Digimon card from my trash to the top of the deck?",
        "reference": "[1]"
      }
    ]
  },
