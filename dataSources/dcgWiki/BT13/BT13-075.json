      },
      {
        "answer": "The attack has already been declared, so the attack will continue.",
        "question": "A Digimon with a play cost of 9 or less attacked a player, digivolved using a [When Attacking] effect, and became a Digimon with a play cost of 10 or more in a state where this card's [On Play][When Digivolving] effect was activated for my opponent. What happens to the attack in such cases?",
        "reference": "[1]"
      }
    ]
