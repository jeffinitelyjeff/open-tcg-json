    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT13-092#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT13-092 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't.  This card’s [When Digivolving] effect can only be used to search your opponent's hand for the card you choose to trash from their hand.",
        "question": "Can I use this card's [When Digivolving] effect to look at the card that my opponent adds to their hand from their security stack?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  This card's [When Attacking] effect reads \"\"your opponent's Digimon that share a name with the returned card,\"\" therefore if you return your opponent's [Greymon] to their deck, you can only delete your opponent's Digimon with the [Greymon] name.",
        "question": "If I use this card's [When Attacking] effect to return my opponent's [Greymon] to the bottom of their deck from their trash, can I delete my opponent's cards such as [MetalGreymon] and [WarGreymon]?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "If I use this card's [When Attacking] effect to return my opponent's card with \"This card/Digimon is also treated as [XX]\" to the bottom of their deck from their trash, can I delete both my opponent's Digimon with the same name as that card and my opponent's Digimon with the [XX] name?",
        "reference": "[1]"
      },
      {
        "answer": "No, since the card was not revealed by a security check, its [Security] effect can't be activated.",
        "question": "If the card that my opponent adds to their hand from their security stack by this card's [When Digivolving] effect has a [Security] effect, does that effect activate?",
        "reference": "[1]"
      }
    ]
  },
