    ],
    "rulings": [
      {
        "answer": "No, you can't.  You can only return your own Tamer to the hand for Burst Digivolve.",
        "question": "Can I return an opponent's Tamer to its owner's hand for this card's Burst Digivolve?",
        "reference": "[1]"
      },
      {
        "answer": "The player that activated this card's effect. The player chooses the cards in their opponent's hand until there are only 8 left and the order they are returned to the deck before returning them to the bottom of the deck.",
        "question": "Which player chooses the cards in my opponent's hand to return to the deck with this card's [When Attacking] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.  After your opponent activates this effect, they select cards without looking at them, therefore they can't check the cards before they are returned to the bottom of the deck. However, the owner of the returned cards may look at them before returning them to the bottom of the deck.",
        "question": "When using this card's [When Attacking] effect to return cards from my hand to the bottom of my deck, can I check what cards I am returning to my deck?",
        "reference": "[1]"
      }
    ]
