    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT11-112#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT11-112 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes you can. In such cases, even if there's no [When Digivolving] effect to target with this effect, this card still becomes suspended.",
        "question": "When one of my Digimon with [Veedramon] without a [When Digivolving] effect becomes suspended, can I suspend this card?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "My Digimon with [Veedramon] attacks and becomes suspended. After that, it digivolves into a different Digimon with the [When Attacking] effect of [BT9-109 X Antibody] in its digivolution cards. If the card it digivolved into has a [When Digivolving], if I suspend this card with this card's [All Turns] effect, can I activate the [When Digivolving] effect of the card it digivolved into?",
        "reference": "[1]"
      }
    ]
  },
