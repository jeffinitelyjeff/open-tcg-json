  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT14-060#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT14-060 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "This is a special rule for this card that treats it as a card that has the [Commandramon] name. This is a rule and not an effect, therefore this card is treated as having the [Commandramon] name when the card is in your hand, breeding area, or any other area.",
        "question": "What does this card's \"(Rule) Name: Also treated as [Commandramon]\" mean, exactly?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can.",
        "question": "Can this card be selected as the target of an effect that targets exactly [Commandramon] due to the text \"(Rule) Name: Also treated as [Commandramon]\"?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "If one of the cards revealed from my deck by this card's [When Attacking] effect is a Tamer card with the [D-Brigade] or [DigiPolice] trait and a play cost of 3 or less, can I play that card?",
        "reference": "[1]"
      },
      {
        "answer": "\"When [...] would leave the battle area\" refers to when this Digimon is placed in the trash, returned to the hand/deck, placed in the security stack, moved to the breeding area, or placed under another card.",
        "question": "What does this card's \"When [...] would [...] leave the battle area\" mean, exactly?",
        "reference": "[1]"
      }
    ]
  },
