  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-082#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-082 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "The player who controls this card chooses.",
        "question": "Which player chooses the Digimon to suspend with this card's skill?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it does.  If your opponent attacks you with a Digimon, if this Digimon is suspended, its effect can be activated at counter timing even if it it was unsuspended when the attack was declared.",
        "question": "My opponent attacks with a Digimon that has a When Attacking effect that suspends an opponent's Digimon, and uses it to suspend one of my unsuspended Digimon. When they do, does this card's effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't. This Digimon's [Opponent's Turn] effect triggers at counter timing, before a block can be declared with ＜Blocker＞ at blocker timing. So, if this Digimon is not suspended during the counter timing, you can't activate this Digimon's [Opponent's Turn] effect.",
        "question": "This Digimon has ＜Blocker＞ and is currently unsuspended when my opponent attacks with a Digimon. If I suspend this Digimon to block the opponent's Digimon, can I activate this card's effect to suspend one of my opponent's Digimon?",
        "reference": "[1]"
      }
    ]
  },
