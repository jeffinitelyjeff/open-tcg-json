  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-115#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-115 (Mar. 28, 2024)"
      },
      {
        "link": "https://cdn.discordapp.com/attachments/749146995708395601/812189569625358387/Screenshot_2021-02-19_Veedramon_ruling__ref__00D281zKgv__5000I271K06_ref__-_renagade678_gmail_com_-_.png",
        "num": 2,
        "text": "English Carddass Email: Veedramon Once Per Turn (Feb. 19, 2021)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it does. This card's When Attacking effect doesn't depend upon the color of your Tamers.",
        "question": "Does this card's When Attacking effect activate when I have a Tamer that isn't blue in play?",
        "reference": "[1]"
      },
      {
        "answer": "No. No matter how many blue Tamers you have in play, the effect only grants +1000 DP.",
        "question": "I have 2 blue Tamers in play. During my turn, does this card's inherited effect grant +2000 DP?",
        "reference": "[1]"
      },
      {
        "answer": "No, you cannot because it was already used. [Once Per Turn] effects are per card.",
        "question": "After unsuspending itself with its [When Attacking] [Once Per Turn] effect, I digivolve into a new Digimon and attack with it. The security check reveals a card that ＜De-Digivolve  1＞ it back into [BT1-115 Veedramon]. Can I use the [Once Per Turn] effect of Veedramon again?",
        "reference": "[2]"
      },
      {
        "answer": "Yes, you can use the [Once Per Turn] effect of the new [BT1-115 Veedramon] again. [Once Per Turn] effects are per card.",
        "question": "After unsuspending itself with its [When Attacking] [Once Per Turn] effect, it got ＜De-Digivolve  1＞ into a level 3. I evolve it back into [BT1-115 Veedramon]. Can I use its effect?",
        "reference": "[2]"
      }
    ]
  },
