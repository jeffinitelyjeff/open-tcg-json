  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-085#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-085 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "You can resolve their effects in any order. For example, if you're starting the turn at 1 memory, you can resolve this card's effect first to go up to 3 memory, then activate [ST2-12 Matt Ishida]'s effect to go to 4 memory and above.",
        "question": "I have both this card and [ST2-12 Matt Ishida] in play. How do I activate their effects?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. Each card's effect activates individually: ＜Security A. +1＞ gets applied twice, allowing you to check two extra cards.",
        "question": "If I have two copies of this card in my battle area, does my Digimon with 4 or more digivolution cards gain ＜Security A. +1＞ twice?",
        "reference": "[1]"
      },
      {
        "answer": "Your Digimon loses ＜Security A. +1＞, and the second check isn't performed.",
        "question": "I use this card's effect to give one of my Digimon ＜Security A. +1＞, which I use to attack my opponent. The card revealed from the first check has a security effect that reduces my Digimon's digivolution cards to 3 or fewer. Does it still have ＜Security A. +1＞?",
        "reference": "[1]"
      }
    ]
  },
  "securityEffect": "[Security] Play this card without paying the cost.",
