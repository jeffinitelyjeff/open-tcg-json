  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-084#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-084 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "You can digivolve into this card from a red or blue level 6 Digimon by paying its digivolve cost.",
        "question": "How can I digivolve into this card?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. The chosen Digimon and all Digimon with the same name as that Digimon are deleted.",
        "question": "I use this card's When Digivolving effect to choose one of my opponent's Digimon. Is that Digimon deleted?",
        "reference": "[1]"
      },
      {
        "answer": "Just [Greymon]. Only Digimon with names that completely match the specified name are deleted.",
        "question": "I choose [Greymon] with this card's When Digivolving effect while my opponent has a [Greymon], [MetalGreymon], and [WarGreymon] in play. Are all of them deleted, or just [Greymon]?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. The card numbers may be different, but the names match. All of your opponent's [MetalGreymon] cards are deleted.",
        "question": "My opponent has [ST1-09 MetalGreymon], [BT1-021 MetalGreymon], and [BT1-114 MetalGreymon] in play in their battle area. I use this card's When Digivolving effect to choose [ST1-09 MetalGreymon]. Are all of my opponent's [MetalGreymon] cards deleted?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can choose not to.",
        "question": "If I attack with this Digimon when it has a level 6 Digimon card in its digivolution cards, do I always have to activate this card's When Attacking effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.",
        "question": "Can I use this card's [When Attacking] effect to return a level 6 digivolution card to my hand but choose to not unsuspend this card?",
        "reference": "[1]"
      }
    ]
  },
