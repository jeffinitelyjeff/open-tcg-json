  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-112#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-112 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes. The effect has no limit to the number of times it can be used. As long as you keep deleting your opponent's Digimon, you can keep using the effect to unsuspend this card.",
        "question": "I've given one of my Digimon this card's effect. Can I unsuspend it over and over again every time I use it to delete an opponent's Digimon in battle?",
        "reference": "[1]"
      },
      {
        "answer": "No, the effect doesn't activate in battles with Security Digimon.",
        "question": "I've given one of my Digimon this card's effect. If it deletes an opponent's Security Digimon in battle, can I unsuspend it?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, if your Digimon deletes an opponent's Digimon and survives, you can unsuspend it, even if the opposing Digimon had ＜Blocker＞.",
        "question": "I've given one of my Digimon this card's effect. I attack with it, and my opponent blocks it. If my Digimon deletes the opponent's blocking Digimon and survives, can I unsuspend it?",
        "reference": "[1]"
      },
      {
        "answer": "No. You can only unsuspend the Digimon with this effect if it deletes the Digimon it's currently attacking. Other Digimon don't count.",
        "question": "I've given one of my Digimon this card's effect. I attack an opponent's Digimon with it, and an effect causes one of my opponent's other Digimon to be deleted during the battle. Do I still get to unsuspend my attacking Digimon?",
        "reference": "[1]"
      }
    ]
  },
