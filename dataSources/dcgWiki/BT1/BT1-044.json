  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT1-044#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT1-044 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, Digi-Egg cards aren't Digimon cards, so they can't be played with this effect.",
        "question": "Can I use this card's effect to play a Digi-Egg in its digivolution cards to my battle area?",
        "reference": "[1]"
      },
      {
        "answer": "No, it's treated as a separate Digimon, and enters play unsuspended.",
        "question": "I suspend this card as I declare its attack. If I use its effect to play a Digimon card from its digivolution cards, does that Digimon enter play suspended?",
        "reference": "[1]"
      },
      {
        "answer": "No, it's treated as a separate Digimon, and doesn't receive any effects that currently apply to the original Digimon.",
        "question": "If I use this card's effect to play a Digimon card from its digivolution cards, does that Digimon carry over any effects currently applied to this Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it does.",
        "question": "If I use this card's effect to play a Digimon card with an [On Play] effect, does that effect activate as the Digimon enters play?",
        "reference": "[1]"
      },
      {
        "answer": "It activates immediately after the card enters play. Even if there are other [When Attacking] and \"when one of your Digimon attacks\" effects waiting to be activated, the [On Play] effect was just triggered, so it activates first.",
        "question": "If I use this card's effect to play a Digimon card with an [On Play] effect, when does that effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, it's considered to have just entered play, so it can't attack.",
        "question": "I use this card's effect to play a Digimon card. Can it attack this turn?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, as long as you are able to.",
        "question": "If this Digimon has a level 4 or lower Digimon card in its digivolution cards, do I have to activate this card's effect?",
        "reference": "[1]"
      }
    ]
  },
