    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX6-074#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX6-074 (Jun. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't.  You can’t ignore digivolution requirements when using this card's [Your Turn] effect.",
        "question": "Can I use this card's [Your Turn] effect to digivolve into [Angewomon] or [LadyDevimon] in the trash regardless of its digivolution requirements?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, that's correct.",
        "question": "I activated this card's [Your Turn] effect when I played [ST10-04 Gatomon]. At such times, I want to digivolve [ST10-04 Gatomon] into  [Angewomon] or [LadyDevimon] with the cost reduced by 1, but can I use [ST10-04 Gatomon]'s [Your Turn] effect to reduce the digivolution cost again by 2?",
        "reference": "[1]"
      },
      {
        "answer": "No. You can’t ignore the digivolution requirements, so you can’t DNA digivolve into a Digimon card that doesn’t have [DNA Digivolution].",
        "question": "Can I use this card's [End of Your Turn] effect to DNA digivolve into a Digimon card in the hand that doesn't have [DNA Digivolution]?",
        "reference": "[1]"
      },
      {
        "answer": "No. You can’t ignore the digivolution requirements, so you can’t DNA digivolve using Digimon that aren’t specified in [DNA Digivolution].",
        "question": "Can I use this card's [End of Your Turn] effect to DNA digivolve using Digimon cards in the hand that aren't specified in [DNA Digivolution]?",
        "reference": "[1]"
      }
    ]
  },
