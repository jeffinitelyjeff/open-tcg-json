  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX6-057#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX6-057 (Jun. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "A Digimon with a \"this Digimon isn't affected by your opponent’s effects\" effect can also be chosen as a target for this effect, therefore your opponent's Digimon will be affected by this card's effect as soon as it loses the \"this Digimon isn't affected by your opponent’s effects\" effect.  As a result, it's deleted at the [End of Your Turn] timing.",
        "question": "What happens if this card's [On Play] [When Digivolving] effect is given to a Digimon that activated a \"this Digimon isn't affected by your opponent’s effects until the end of your opponent's turn\" effect?",
        "reference": "[1]"
      },
      {
        "answer": "\"When [...] would leave the battle area other than by battle\" refers to when this Digimon is placed in the trash other than as a result of a battle, returned to the hand/deck, placed in the security stack, moved to the breeding area, or placed under another card.",
        "question": "What does this card's \"when [...] would leave the battle area other than by [...] a battle\" mean, exactly?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I use this card's [All Turns] effect to delete an opponent's level 5 or lower Digimon and prevent this card from leaving the battle area?",
        "reference": "[1]"
      }
    ]
  },
