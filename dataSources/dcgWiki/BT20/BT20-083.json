  "image": "https://static.wikia.nocookie.net/digimoncardgame/images/2/2c/BT20-083.png/revision/latest?cb=20250207192013",
  "inheritedEffect": "[Breeding] [Opponent's Turn] When your security stack is removed from, by suspending this Digimon, play 1 [Omekamon] from this Digimon's digivolution cards without paying the cost.",
  "level": "4",
  "name": "Omekamon",
  "nameJapanese": "オメカモン",
  "playCost": "5",
  "rarity": "Rare",
  "rule": "[Rule] Name: Also treated as [X Antibody].",
  "rulings": {
    "references": [
      {
        "link": "https://digimoncard.com/rule/?card_no=BT20-083#qaResult_card",
        "num": 1,
        "text": "Official JP Q&A for BT20-083 (2025/01/24, translated by DeepL)"
      }
    ],
    "rulings": [
      {
        "answer": "This effect can be triggered and activated while the card is in the Breeding Area. It cannot be triggered or activated outside of the Breeding Area.",
        "question": "What are the effects of the [nurturing] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Security] effects are activated first. Security] effects, if checked, will be activated immediately without pending activation. Other triggered effects are activated from the turn player's side.",
        "question": "If the [Security] effect, the \"when security is checked\" effect, and the \"when security is reduced\" effect are triggered simultaneously, in which order do they activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, they can be played.",
        "question": "I have a Digimon in my Breeding Area that has this card as its digivolution card. Can I use this card's inherited effect to rest that Digimon and play the digivolution card itself?",
        "reference": "[1]"
      }
    ]
  },
