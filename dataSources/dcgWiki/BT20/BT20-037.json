  "rulings": {
    "references": [
      {
        "link": "https://digimoncard.com/rule/?card_no=BT20-037#qaResult_card",
        "num": 1,
        "text": "Official JP Q&A for BT20-037 (2025/01/24, translated by DeepL)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, for each Lv.6 card from which this card digivolves, rest an opponent's Digimon/tamer and give it Memory +1.",
        "question": "Does this card's [When Digivolving] effect rest 2 opponent's Digimon or Tamer and give them Memory +2 if this card has 2 Lv.6 cards in its inherited effect?",
        "reference": "[1]"
      },
      {
        "answer": "This effect prevents a card's [On Play] effect from being activated. When a card appears and triggers the [On Play] effect, or the \"Activate [On Play] effect\" effect, etc., the card will no longer be able to activate the [On Play] effect.",
        "question": "What does \"[On Play] the effect is not activated\" mean?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates. If the effect is triggered by [When Attacking], it can be activated.",
        "question": "I attacked with a card that has \"No [On Play] effect activated\". In this case, can I activate the card's [On Play] and [When Attacking] effects?",
        "reference": "[1]"
      },
      {
        "answer": "No, it cannot be activated.",
        "question": "Can a card with \"No [On Play] effect\" activate its own [On Play] effect with the \"Activate 1 [On Play] effect\" effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, it cannot be activated.",
        "question": "Can a card with \"No [On Play] effect\" activate another card's [On Play] effect with the \"Activate one [On Play] effect as this card's effect\" effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates.",
        "question": "Can I activate the [On Play] effect of a card that does not have the \"No [On Play] effect\" option?",
        "reference": "[1]"
      },
      {
        "answer": "No, I cannot.",
        "question": "Can a card with \"Does not activate [On Play] effect\" handle only the \"By\" condition of the [On Play] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, it is not consumed. No [X times per turn] is consumed because the [On Play] effect cannot be activated at the time of play.",
        "question": "A card with [On Play] [When Attacking] [Once Per Turn] appeared while the \"[On Play] effect is not activated.\" was in effect. In this case, the effect could not be activated at the time the card played, but does it consume the [X times per turn] of the effect?",
        "reference": "[1]"
      }
    ]
  },
