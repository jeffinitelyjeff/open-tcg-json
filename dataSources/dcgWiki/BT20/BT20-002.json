  "rulings": {
    "references": [
      {
        "link": "https://digimoncard.com/rule/?card_no=BT20-002#qaResult_card",
        "num": 1,
        "text": "Official JP Q&A for BT20-002 (2025/01/24, translated by DeepL)"
      }
    ],
    "rulings": [
      {
        "answer": "It refers to cards with the specified word or icon included in \"name, trait, effect, inherited effect, <Overflow X>, jogress, digivolution requirements, burst digivolution\". For example, a card with the text \"Knightmon\" refers to a card whose name is \"Dark Knightmon\" or whose effect says \"Knightmon\".",
        "question": "What do you mean by \"cards with text?\"",
        "reference": "[1]"
      },
      {
        "answer": "Digimon with the text \"DRACOMON\" or Digimon with the text \"EXAMON\".",
        "question": "Can the inherited effect of this card be activated if it is in the digivolution card of which card?",
        "reference": "[1]"
      }
    ]
  },
