  "rulings": {
    "references": [
      {
        "link": "https://digimoncard.com/rule/?card_no=BT20-052#qaResult_card",
        "num": 1,
        "text": "Official JP Q&A for BT20-052 (2025/01/24, translated by DeepL)"
      }
    ],
    "rulings": [
      {
        "answer": "Turn the second card from the top of the security face up.",
        "question": "The situation is that only the top card of the opponent's security is face-up. If you activate the [When Digivolving] effect of this card, which card of the security should you turn face up?",
        "reference": "[1]"
      },
      {
        "answer": "It becomes ostensible security and remains public. The rules are the same as for normal security, except that it is ostensible.",
        "question": "What happens to a card placed face up in security by an effect?",
        "reference": "[1]"
      },
      {
        "answer": "Checked as published. The rules are the same as for normal checks, except as published.",
        "question": "What happens when checking a security placed face down?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, triggered.",
        "question": "If a security placed face up is checked, does the card's [Security] effect trigger?",
        "reference": "[1]"
      },
      {
        "answer": "The security that was face up is turned back face down and then shuffled. After shuffling, the cards are not turned face up.",
        "question": "What happens when shuffling a security that contains a security placed face up?",
        "reference": "[1]"
      },
      {
        "answer": "Security] effects are activated first. Security] effects, if checked, will be activated immediately without pending activation. Other triggered effects are activated from the turn player's side.",
        "question": "If the [Security] effect, the \"when security is checked\" effect, and the \"when security is reduced\" effect are triggered simultaneously, in which order do they activate?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, triggered.",
        "question": "I attacked with this card and checked the security face-up. At this time, if I activate this card's [Your Turn] effect and place one of the stacked cards from the top under the security, does it trigger the [End of Attack] effect of the Digimon that was under this card?",
        "reference": "[1]"
      }
    ]
  },
