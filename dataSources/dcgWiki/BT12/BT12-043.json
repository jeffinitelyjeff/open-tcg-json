  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT12-043#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT12-043 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. Tamers cannot attack, so a [Marcus Damon] Tamer in the battle area can't attack. However, if an effect such as the one on [BT12-092 Marcus Damon] causes it to be treated as a Digimon, then it is able to attack.",
        "question": "Can my [Marcus Damon] Tamer, that gains +3000 DP and ＜Security A. +1＞ from this card's [Your Turn] effect, attack as just a Tamer?",
        "reference": "[1]"
      },
      {
        "answer": "No, effects that target Digimon can't target a [Marcus Damon] that's just a Tamer in the battle area.",
        "question": "When an effect that targets Digimon with 3000 DP or less is activated, can a [Marcus Damon] that gains +3000 DP from this card's [Your Turn] effect be chosen as a target for that effect?",
        "reference": "[1]"
      },
      {
        "answer": "This effect is not an effect with a set duration such as \"for the turn,\" so the effect is lost unless the Digimon's name is still [Marcus Damon] after digivolving.",
        "question": "My [Marcus Damon] digivolved into a Digimon with a \"you may digivolve as if your Tamer is a level 3 Digimon\" effect. In such cases, what happens to the +3000 DP/＜Security A. +1＞ that [Marcus Damon] gained from this card's [Your Turn] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, Tamers can't have DP, so it's not treated as a Tamer with 3000 DP.",
        "question": "Is a [Marcus Damon] that gained +3000 DP by this card's [Your Turn] effect treated as a Tamer with 3000 DP?",
        "reference": "[1]"
      }
    ]
  },
