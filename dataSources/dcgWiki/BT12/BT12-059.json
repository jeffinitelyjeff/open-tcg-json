    "rulings": [
      {
        "answer": "Yes, as long as either a Digimon card with [Greymon] or 1 Tamer card with [Tai Kamiya] is among the cards revealed, you can add it to your hand.",
        "question": "This card’s effect reveals 4 cards. If the cards revealed only include a Digimon card with [Greymon] or 1 Tamer card with [Tai Kamiya], can I still add a card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. This card's effect reads “Add 1 Digimon card [...] and 1 Tamer card [...] among them to your hand,” so you must add as many cards to your hand as possible.",
        "question": "This card's effect reveals 4 cards. If both a Digimon card with [Greymon] and a Tamer card with [Tai Kamiya] are among the cards revealed, can I choose to only add one of them to my hand, and return the other cards to the bottom of my deck?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, those are Tamer cards with [Tai Kamiya], so you can add one to your hand.",
        "question": "This card's effect reveals 4 cards. If [BT5-093 Tai Kamiya & Matt Ishida], [BT9-084 Tai Kamiya & Kari Kamiya], or [P-012 Tai Kamiya (V-Tamer)] is one of the cards revealed, can I add that card to my hand?",
        "reference": "[1]"
      }
    ]
