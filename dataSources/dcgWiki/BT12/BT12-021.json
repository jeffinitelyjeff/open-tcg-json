    ],
    "rulings": [
      {
        "answer": "Yes, as long as either a Digimon card with [Imperialdramon] or the [Free] trait, or a Tamer card with [Davis Motomiya] is among the cards revealed, you can add it to your hand.",
        "question": "If the 3 cards revealed by this card's effect only include 1 Digimon card with [Imperialdramon] or the [Free] trait, or 1 Tamer card with [Davis Motomiya] among them, can I still add a card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. This card's effect reads “Add 1 card [...] and 1 Tamer card [...] among them to your hand,” so you must add as many cards to your hand as possible.",
        "question": "If the 3 cards revealed by this card's effect include both a Digimon card with [Imperialdramon] or the [Free] trait, and a Tamer card with [Davis Motomiya] among them, can I choose to only add one of them to my hand and return the rest to the bottom of the deck?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it's a Tamer card with [Davis Motomiya], so you can add it to your hand.",
        "question": "This card's effect reveals 3 cards. If a [BT8-088 Davis Motomiya & Ken Ichijoji] is among the cards revealed, can I add that card to my hand?",
        "reference": "[1]"
      }
    ]
