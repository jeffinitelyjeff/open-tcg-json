  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT12-083#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT12-083 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "You count each of your Tamers with different colors. If you have a 2-color Tamer card, it counts as 1 Tamer with a different color as long as 1 of the colors is different from your other Tamers. For example, if you have 1 red Tamer, 1 blue/yellow Tamer, and 1 red/yellow Tamer, you can count them as 1 red Tamer, 1 blue Tamer, and 1 yellow Tamer for a total of 3.",
        "question": "What does the \"For each Tamer you have in play with a different color\" condition in this card's [When Digivolving] effect mean?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can attack even when suspended.",
        "question": "If this Digimon has 4 or more digivolution cards, does its [End of Your Turn] effect allow it to attack even if it is suspended?",
        "reference": "[1]"
      },
      {
        "answer": "No you can't. A Digimon with the \"isn't affected by the effects of your opponent's Digimon\" effect can be selected as the destination of the Digimon that would be placed as a digivolution card, but in that case it can't be placed as the Digimon isn't affected by the effect.",
        "question": "Can I use this card's [When Digivolving] effect to place 1 of my opponent's Digimon as a digivolution card of another of their Digimon with the \"isn't affected by the effects of your opponent's Digimon\" effect?",
        "reference": "[1]"
      }
    ]
  },
