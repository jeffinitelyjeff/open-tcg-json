  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT9-055#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT9-055 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it can.",
        "question": "I activate this card’s [When Digivolving] effect in the middle of an attack to suspend an opponent's Digimon. Can this card's effect then switch the target of attack to one of my opponent’s other suspended Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No. This effect specifies a card name, so you must have a card whose name is either [GranKuwagamon] or [X Antibody] in this Digimon’s digivolution cards. Having a card with [X Antibody] in its traits doesn't count.",
        "question": "This card’s effect reads, “If [GranKuwagamon] or [X Antibody] is in this Digimon’s digivolution cards”. Does having a card with [X Antibody] in its traits count?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can. A \"this Digimon can't be attacked\" effect prevents a Digimon from being chosen as the target upon an attack declaration, therefore an attack can be switched to a Digimon with such an effect by using an effect that switches the target after the attack declaration.",
        "question": "Can I switch the target of attack to an opponent's Digimon with a \"this Digimon can't be attacked\" effect when I activate this card's [When Digivolving] effect during an attack?",
        "reference": "[1]"
      }
    ]
  },
