    ],
    "rulings": [
      {
        "answer": "Yes, as long as either a card with [Greymon] or [X Antibody] is among the cards revealed, you add it to your hand.",
        "question": "This card’s effect reveals 3 cards. If the cards revealed only include either a card with [Greymon] or [X Antibody], do I still add a card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. This card's effect reads “Add 1 card [...] among them to your hand,” so you must add as many cards to your hand as possible. In this case, you must add both 1 card with [Greymon], and 1 [X Antibody] to your hand.",
        "question": "This card’s effect reveals 3 cards. If both a card with [Greymon] and [X Antibody] are among the cards revealed, can I choose to add only one of them to my hand, and place the remaining card at the bottom of my deck?",
        "reference": "[1]"
      }
    ]
  },
