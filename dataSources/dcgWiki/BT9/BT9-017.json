  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT9-017#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT9-017 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "If no Digimon was deleted by this effect” refers to a state in which, when resolving this Digimon’s [When Digivolving] effect, your opponent doesn't have a Digimon in play, or you try to delete an opponent's Digimon that can't be deleted with the effect. Essentially, if you didn't delete a Digimon with the effect “Delete 1 of your opponent’s Digimon with the lowest DP,” follow the instructions listed after “If no Digimon was deleted by this effect...",
        "question": "This card’s [When Digivolving] effect reads, “Delete 1 of your opponent's Digimon with the lowest DP.” What situations does “If no Digimon is deleted by this effect” refer to, specifically?",
        "reference": "[1]"
      },
      {
        "answer": "No. This effect reads, “Delete,” not “You may delete,” so if there’s a valid target in play, you must choose it with the effect. You can't choose to NOT activate the effect.",
        "question": "My opponent has a Digimon in play. Can I choose not to delete my opponent’s Digimon with this card’s [When Digivolving] effect in order to unsuspend this Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. When there are multiple Digimon tied for lowest DP, you can choose any of them. This means you can choose the Digimon with the effect preventing deletion to get the “if no Digimon was deleted by this effect” part of the effect.",
        "question": "My opponent has a Digimon with an effect that reads, “This Digimon can't be deleted by your opponent’s effects,” and another Digimon with no effect (both Digimon have the same DP). Can I intentionally choose the Digimon with the effect preventing deletion for this card’s [When Digivolving] effect, in order to unsuspend this Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No. This effect specifies a card name, so you must have a card whose name is either [Gallantmon] or [X Antibody] in this Digimon’s digivolution cards. Having a card with [X Antibody] in its traits doesn't count.",
        "question": "This card’s effect reads, “if [Gallantmon] or [X Antibody] is in this Digimon’s digivolution cards”. Does having a card with [X Antibody] in its traits count?",
        "reference": "[1]"
      }
    ]
  },
