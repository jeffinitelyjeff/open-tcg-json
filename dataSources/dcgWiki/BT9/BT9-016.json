  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT9-016#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT9-016 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. This effect specifies a card name, so you must have a card whose name is either [WarGreymon] or [X Antibody] in this Digimon’s digivolution cards. Having a card with [X Antibody] in its traits doesn't count.",
        "question": "This card’s effect reads, “If [WarGreymon] or [X Antibody] is in this Digimon’s digivolution cards”. Does having a card with [X Antibody] in its traits count?",
        "reference": "[1]"
      },
      {
        "answer": "Performing the check causes a card to be removed from your opponent’s security stack, causing this card’s [All Turns] effect to trigger. If you flip over a card with a [Security] effect, however, the [Security] effect will trigger afterwards, which means it will activate first.  After that, if there are no other triggered effects, you'll gain 1 memory before the battle with the Security Digimon.",
        "question": "I attack my opponent and perform a security check. Does this card’s [All Turns] effect cause me to gain 1 memory first, before the [Security] effect of the card I flipped over activates, or before the battle with my opponent's Security Digimon occurs?",
        "reference": "[1]"
      }
    ]
  },
