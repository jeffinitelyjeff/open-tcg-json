  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT9-083#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT9-083 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "The player who controls this card decides.",
        "question": "When placing cards from my opponent's trash at the bottom of their deck with this card’s [When Digivolving] effect, who gets to decide the order of the cards?",
        "reference": "[1]"
      },
      {
        "answer": "Digi-Egg cards in your opponent’s trash can be chosen as part of the effect, but they’re returned to the bottom of your opponent’s Digi-Egg deck instead of their normal deck.",
        "question": "Does this card’s [When Digivolving] effect let me place Digi-Egg cards from my opponent's trash at the bottom of their deck?",
        "reference": "[1]"
      },
      {
        "answer": "No. Even if you have multiple cards with [Mega] in their traits, this effect will only place 10 cards from your opponent's trash at the bottom of their deck.",
        "question": "If there are 2 cards with [Mega] in their traits in this Digimon’s digivolution cards, do I get to place 20 cards from my opponent’s trash at the bottom of their deck with this card's [When Digivolving] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it does. Place as many cards as you can at the bottom of your opponent’s deck.",
        "question": "If my opponent has 9 or fewer cards in their trash, does this card’s [When Digivolving] effect still activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  You must activate this effect at the start of your turn.",
        "question": "Can I choose not to activate this card’s [Start of Your Turn] effect to avoid trashing any cards?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it does.  While there are no cards in your opponent’s security stack to trash, you still perform the part of the effect that reads, “Trash the top card of this Digimon.”",
        "question": "Does this card’s [Start of Your Turn] effect activate even when my opponent’s security stack is empty?",
        "reference": "[1]"
      },
      {
        "answer": "No. When there are no digivolution cards, you can't perform \"trash the top card of this Digimon,\" so it doesn't activate.",
        "question": "Does this card's [Start of Your Turn] effect activate when this card has no digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "No. The [Start of Your Turn] effect on the [BT9-083 Omnimon: Merciful Mode] that was a digivolution card isn't yet in a state where it can activate at the start of your turn, therefore it doesn't trigger.",
        "question": "My turn starts when I have this card with [BT9-083 Omnimon: Merciful Mode] as its top digivolution card. If I use this card's [Start of Your Turn] effect to trash this card, then activate the [Start of Your Turn] effect on the [BT9-083 Omnimon: Merciful Mode] that was a digivolution card, can I trash a total of 2 cards from my opponent's security stack?",
        "reference": "[1]"
      }
    ]
  },
