    ],
    "rulings": [
      {
        "answer": "No, it doesn’t activate.",
        "question": "Does this card's [Your Turn] effect activate when the hand increases from the digivolution bonus upon digivolution by an effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, they don’t.  Although cards are added to both players' hands, they are added at the same timing, therefore your opponent only adds 1 card from their security stack to the hand.",
        "question": "If both my hand and my opponent's hand increase when we both draw 1 card from our decks using an effect such as BT16-020 [GaoGamon]'s [When Digivolving] effect, does my opponent add 2 cards from the top of their security stack to the hand using this card's [Your Turn] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I use this card's [On Deletion] effect to play a Tamer card even if I don't return a card from the trash to the hand?",
        "reference": "[1]"
      }
    ]
  },
