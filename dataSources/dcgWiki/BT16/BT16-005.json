  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT16-005#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT16-005 (Nov. 1, 2024)"
      },
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT16-005#qaResult_card",
        "num": 2,
        "text": "Official English Q&A for BT16-005 (Jun. 6, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it triggers.",
        "question": "I have a Digimon with this card in its digivolution cards, and another of my Digimon with ＜Collision＞ is attacking.  I used the ＜Collision＞ effect to give ＜Blocker＞ to an opponent's Digimon that didn't originally have ＜Blocker＞, and it blocks.  At such times, if both Digimon have the same DP, they both lose the battle, and they're deleted, does this card's inherited effect trigger?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't activate it.  The Digimon with this card in its digivolution cards is deleted before this card's inherited effect activates, therefore it can't be activated.",
        "question": "A Digimon with this card in its digivolution cards battled an opponent's Digimon, and both Digimon lost the battle and were deleted.  Can I activate this card's inherited effect at such times?",
        "reference": "[1]"
      },
      {
        "answer": "It triggers once.  If both Digimon lose a battle, both are deleted at the same time.",
        "question": "I have a Digimon with this card in its digivolution cards, other Digimon battled, and both Digimon lost the battle and were deleted.  At such times, if both Digimon have ＜Blocker＞, how many times does this card's inherited effect trigger?",
        "reference": "[2]"
      }
    ]
  },
