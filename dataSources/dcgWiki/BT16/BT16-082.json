  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT16-082#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT16-082 (Mar. 28, 2024)"
      },
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT16-082#qaResult_card",
        "num": 2,
        "text": "Official English Q&A for BT16-082 (Sep. 13, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, it activates.",
        "question": "Does this card's [Your Turn] effect activate when this Digimon itself moves from the breeding area to the battle area?",
        "reference": "[1]"
      },
      {
        "answer": "It activates during the breeding phase. If effects trigger during the breeding phase, the main phase will come after all effects have activated.",
        "question": "When one of my Digimon moves from the breeding area to the battle area during the breeding phase, does this card's [Your Turn] effect activate during the breeding phase or main phase?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it activates.",
        "question": "I moved one of my Digimon from the breeding area to the battle area when all of my Digimon's DP is reduced by an effect. The moved Digimon's DP becomes 0 and is deleted due to the DP-reducing effect, but does this card's [All Turns] effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't activate it.  When a card with an effect that's pending activation leaves an area while activation is pending, the effect can no longer be activated.  In this case, the effect triggers when this card is moved, but because the DP becomes 0 before activation, this card is deleted and removed from the battle area, and the effect can't be activated.",
        "question": "I moved this card from the breeding area to the battle area when all of my Digimon's DP is reduced by an effect. At such times, if this card's DP becomes 0 and is deleted due to the DP-reducing effect after it's moved, can I activate this card's [Your Turn] effect?",
        "reference": "[2]"
      }
    ]
  },
