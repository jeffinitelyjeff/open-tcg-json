    ],
    "rulings": [
      {
        "answer": "They trigger simultaneously, so the turn player activates their effect first.",
        "question": "Which effect activates first, an [On Play] [When Digivolving] effect on an opponent's Digimon that was played/digivolved, or this card's [All Turns] effect?",
        "reference": "[1]"
      },
      {
        "answer": "It will trigger at times such as when a Digimon is played by [BT5-092 Nokia Shiramine] or when a Digimon digivolves by [P-103 Offense Training]'s effect.  It won't trigger for effects that aren't digivolution effects, such as [BT4-011 Agunimon]'s effect that treats a Tamer as a level 3 red Digimon or [BT6-060 Deputymon]'s effect that allows digivolution requirements to be ignored.",
        "question": "What kinds of effects activated by my opponent will trigger this card's [All Turns] effect?",
        "reference": "[2]"
      }
    ]
  },
