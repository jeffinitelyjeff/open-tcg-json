  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX8-065#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX8-065 (Jan. 10, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "EX8-014 [MasterTyrannomon]'s [On Play] [When Digivolving] effect activates first.  As soon as your [Tyrannomon] attacks, the [Your Turn] effects on the 2 copies of this card trigger simultaneously.  The effect on the 1st copy of this card is used to digivolve into EX8-014 [MasterTyrannomon], then EX8-014 [MasterTyrannomon]'s [On Play] [When Digivolving] effect is newly triggered, therefore that effect activates first due to the derived triggering rule.",
        "question": "I have 2 copies of this card in the battle area.  My [Tyrannomon] attacks, and I activate the effect on the 1st copy of this card to digivolve it into EX8-014 [MasterTyrannomon].  At such times, does the [On Play] [When Digivolving] effect on the 2nd copy of this card or EX8-014 [MasterTyrannomon] activate first?",
        "reference": "[1]"
      }
    ]
  },
  "securityEffect": "[Security] Play this card without paying the cost.",
