  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX8-016#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX8-016 (Jan. 10, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can suspend either player's Digimon.",
        "question": "Can I use this card's [On Play] [When Digivolving] effect to suspend either my Digimon or my opponent's Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, it can't attack.  If a \"can\" or \"may\" effect activates at the same timing as a \"can't\" effect, the \"can't\" effect takes precedence.",
        "question": "I have this card in the battle area, and it's suspended.  Can my opponent's BT8-018 [Marsmon] attack their unsuspended Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, they can.  This card's [Opponent's Turn] effect only allows suspended Digimon to be chosen as the attack target upon the attack declaration.  After attacking a suspended Digmon, it will be possible to use ＜Raid＞ to switch the target of the attack to an opponent's unsuspended Digimon.",
        "question": "I have this card in the battle area, and it's suspended.  If my opponent's Digimon attacks my suspended Digimon, can my opponent use ＜Raid＞ on the attacking Digimon to switch the target of the attack to my unsuspended Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it can attack them.",
        "question": "I have this card in the battle area, and it's suspended.  If an opponent's Digimon isn't affected by effects, can it attack Digimon other than suspended Digimon?",
        "reference": "[1]"
      }
    ]
  },
