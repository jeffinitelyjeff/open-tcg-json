  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX8-055#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX8-055 (Jan. 10, 2025)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, you can.",
        "question": "Can I use this card's [When Digivolving] [When Attacking] effect to trash a total of 3 digivolution cards from my multiple different Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  A \"by doing X\" condition can't be met if only some of the required actions are performed.  The conditions for this [When Digivolving] [When Attacking] effect require you to trash the specified number of digivolution cards.",
        "question": "Can I trash just 2 digivolution cards for the conditions of this card's [When Digivolving] [When Attacking] effect?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "Can I use this card's [End of Your Turn] effect to place Digi-Egg cards with the [Mineral] or [Rock] trait from my trash as digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  If this card's [End of Your Turn] effect activates, you must place at least 1 card in digivolution cards.  However, if you choose to not activate this effect, it won't activate and you don't place any cards in digivolution cards.",
        "question": "Can I activate this card's [End of Your Turn] effect but choose to not to place cards with the [Mineral] or [Rock] trait from my trash as this Digimon's bottom digivolution cards?",
        "reference": "[1]"
      }
    ]
  },
