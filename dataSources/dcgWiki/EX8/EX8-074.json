    "rulings": [
      {
        "answer": "Yes, you can suspend either player's Digimon.",
        "question": "Can I use this card's [When Digivolving] effect to suspend either my Digimon or my opponent's Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  A \"by doing X\" condition can't be met if only some of the required actions are performed.  The conditions for this card's 1st effect require you to suspend the specified number of Digimon.",
        "question": "Can I use the conditions for this card's 1st effect to just suspend 1 Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it triggers.",
        "question": "Does this card's [All Turns] effect trigger when this card itself is played?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, it triggers.",
        "question": "Does this card's [All Turns] effect trigger when either my Digimon or my opponent's Digimon is played?",
        "reference": "[1]"
      }
