  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=EX4-011#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for EX4-011 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "It means that the effect will activate at the specified timing if this card is in your trash.",
        "question": "What does [Trash] in this card's [End of Your Turn] effect mean?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, the effect reads “you may play,\" so you can choose not to play it.",
        "question": "After deleting 1 of my Digimon with digivolution cards and [Gallantmon], can I choose to not play this card for this card's [End of Your Turn] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, it means every 10 cards in the total sum of cards in your trash and the cards in your opponent's trash. For example, if you have 15 cards in your trash and your opponent has 9 cards in their trash, the total would be 24. Therefore, you add 4000 to the maximum this DP-based deletion effect can delete, and you can now delete 1 of your opponent's Digimon with 11000 DP or less.",
        "question": "Does \"For every 10 total cards in both players' trashes\" in this card's [On Play] effect mean every 10 cards in either me or my opponent's trashes?",
        "reference": "[1]"
      }
    ]
  },
