      }
    ],
    "rulings": [
      {
        "answer": "This is a special rule for this card that always treats it as if it also has the [Terriermon] name.",
        "question": "What does this card's (Rule) mean, exactly?  (*This card's \"The name of this card/Digimon is also treated as [Terriermon]\" has been changed to \"(Rule) Name: Also treated as [Terriermon].\")",
        "reference": "[1]"
      },
      {
        "answer": "Players should reference \"(Rule) Name: Also treated as [Terriermon].\"     Cards with the \"this card/Digimon is also treated as [Terriermon]\" text are treated as if they have the other text.",
        "question": "This card has two different texts with the same card number: \"This card/Digimon is also treated as [Terriermon]\" and \"(Rule) Name: Also treated as [Terriermon].\" Which should I reference?",
        "reference": "[2]"
      }
    ]
