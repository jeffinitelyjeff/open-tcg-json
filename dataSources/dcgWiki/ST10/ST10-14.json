    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=ST10-14#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for ST10-14 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, that's correct.  If you choose to place an opponent’s Digimon at the top of their security stack, you are in effect choosing to trash the chosen Digimon.",
        "question": "If I use this card’s effect to place an opponent’s Digimon at the top of their security stack, is that Digimon then trashed?",
        "reference": "[1]"
      },
      {
        "answer": "Due to [BT9-103 Kongou]'s effect, cards can't be placed in security stacks, therefore this card's \"place 1 of your opponent's Digimon face down at the top or bottom of your opponent's security stack\" can't be activated, and the target Digimon will be left as-is.",
        "question": "What happens if I use this card while my opponent has [BT9-103 Kongou]'s effect activated?",
        "reference": "[1]"
      },
      {
        "answer": "No. The Digimon isn’t being deleted, so none of the above occurs.",
        "question": "If I use this card’s effect to place an opponent’s Digimon at the top of their security stack, does that Digimon’s [On Deletion] effect activate?  Additionally, do effects on other Digimon and Tamers that care about Digimon being deleted also activate?",
        "reference": "[1]"
      }
    ]
  },
