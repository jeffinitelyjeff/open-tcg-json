      },
      {
        "answer": "This Digimon is played after the battle with the attacking Digimon, and before the next check is performed.",
        "question": "This card is flipped over during a security check, but the attacking Digimon still has security checks remaining. Is this card played off its [Security] effect first, or do I have to wait until my opponent finishes the rest of their security checks?",
        "reference": "[1]"
      }
    ]
