  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT3-008#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT3-008 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Yes, if you only reveal one or the other, you only get to add one card to your hand.",
        "question": "If the cards I reveal from my deck include only either [RagnaLoardmon] or cards with [Legend-Arms] in their types, can I only add 1 card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you may add them both to your hand.",
        "question": "If the cards I reveal from my deck include 2 [RagnaLoardmon] cards with [Legend-Arms] in their types, can I add both of those cards to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "No. If you have cards that are targets of this effect, you must add as many cards to your hand as possible.  However, if the revealed [RagnaLoardmon] has the [Legend-Arms] trait, that card will be treated as a card with the [Legend-Arms] trait. By adding it to your hand, you can return other cards with the [Legend-Arms] trait to the bottom of the deck without adding them to your hand, and if there aren't any other [RagnaLoardmon] revealed, you can add just 1 [RagnaLoardmon] to your hand.",
        "question": "If the cards I reveal from my deck include both a [RagnaLoardmon] card and a card with [Legend-Arms] in its type, do I only get to add 1 to my hand and have to return the rest to the bottom of my deck?",
        "reference": "[1]"
      }
    ]
  },
