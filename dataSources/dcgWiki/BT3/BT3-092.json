    "rulings": [
      {
        "answer": "Yes, both you and your opponent's Digimon were deleted, so you gain two memory.",
        "question": "I have this Digimon in play when one of my other Digimon attacks, deletes an opponent's Digimon, and is deleted in return. Do I gain two memory?",
        "reference": "[1]"
      },
      {
        "answer": "No, Security Digimon aren't considered to be Digimon, so you don't gain any memory.",
        "question": "Do I gain 1 memory from this Digimon's effect when a Security Digimon is deleted?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, the +1 memory effect activates twice, earning you two memory.",
        "question": "When I had this Digimon, another of my Digimon attacked, and both my Digimon and my opponent's Digimon were deleted in the battle. Do I gain 2 memory at such times?",
        "reference": "[1]"
      },
      {
        "answer": "The effects trigger simultaneously, so the turn player gains a memory first, followed by the non-turn player gaining a memory, returning the memory gauge to its original position.",
        "question": "My opponent and I both have this Digimon in play. If another Digimon is deleted, what happens?",
        "reference": "[1]"
      },
      {
        "answer": "No. This Digimon was deleted, so the [All Turns] effect doesn't activate.",
        "question": "If this Digimon attacks an opponent's Digimon and both Digimon end up being deleted, can I gain a memory off this card's effect?",
        "reference": "[1]"
      }
    ]
