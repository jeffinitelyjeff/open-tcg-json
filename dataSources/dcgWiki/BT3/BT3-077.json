    "rulings": [
      {
        "answer": "You can't use Option/Digimon card effects to gain memory, but you can still lose memory if a card effect specifies as such.",
        "question": "My opponent has this card in play when I activate the effect on a card like [BT1-090 Gravity Crush], [BT1-021 MetalGreymon], [BT1-040 WereGarurumon], [BT1-058 Chirinmon], or [BT1-075 Digitamamon]. What happens?",
        "reference": "[1]"
      },
      {
        "answer": "No, you don't gain any memory from it.",
        "question": "My opponent has this card in play. Do I gain memory from [ST2-13 Hammer Spark]'s [Security] effect?",
        "reference": "[1]"
      }
    ]
  },
