    "rulings": [
      {
        "answer": "Yes, if you only reveal one or the other, you only get to add one card to your hand.",
        "question": "If the cards I reveal from my deck include only either a blue or green Digimon card, can I only add 1 card to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you may add them both to your hand.",
        "question": "If the cards I reveal from my deck include 2 multi-coloured Blue-Green Digimon cards, can I add both of those cards to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can choose to add the Blue-Green Digimon as a Blue Digimon so that there are no other Green Digimon to add.",
        "question": "If the cards I reveal from my deck include both a Blue-Green Digimon card and a single-coloured Blue Digimon card, can I choose to add just 1 of them to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can choose to add the Blue-Green Digimon as a Green Digimon so that there are no other Blue Digimon to add.",
        "question": "If the cards I reveal from my deck include both a Blue-Green Digimon card and a single-coloured Green Digimon card, can I choose to add just 1 of them to my hand?",
        "reference": "[1]"
      },
      {
        "answer": "One \"Blue Digimon card\" and one \"Green Digimon card.\"",
        "question": "Which card is added to your hand by this card's [On Play] effect?",
        "reference": "[2]"
      }
    ]
