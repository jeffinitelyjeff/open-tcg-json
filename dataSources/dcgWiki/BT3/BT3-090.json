    "rulings": [
      {
        "answer": "Yes, they do.",
        "question": "If I don't have a level 4 or lower purple or yellow Digimon card in my trash, do both players still trash the top card of their security stack from this card's [When Digivolving] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, they don't.",
        "question": "Do the [Security] effects on cards trashed by this card's [When Digivolving] effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, just because there are no security cards to trash doesn't mean you win the game.",
        "question": "If I activate this card's [When Digivolving] effect when my opponent has an empty security stack, do I win the game?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, you can.",
        "question": "If either or both players have empty security stacks, can I use this card's [When Digivolving] effect to play a level 4 or lower purple or yellow Digimon card from my trash?",
        "reference": "[1]"
      },
      {
        "answer": "Yes, please trash.",
        "question": "Does this card's [When Digivolving] effect trash one of each other's security from the top, even if there is no purple or yellow Lv.4 or lower Digimon card in my trash?",
        "reference": "[2]"
      },
      {
        "answer": "No, it does not activate.",
        "question": "Does the [When Digivolving] effect of this card activate the security effect that the card you trash has?",
        "reference": "[2]"
      },
      {
        "answer": "No, just because you cannot trash a security card does not mean you win the game.",
        "question": "If this card's [When Digivolving] effect is activated when the opponent has 0 security, does it win the game?",
        "reference": "[2]"
      },
      {
        "answer": "Yes, you can play.",
        "question": "If this card's [When Digivolving] effect is activated when I or my opponent or both have 0 security, can I still play a purple or yellow Lv.4 or lower Digimon card from my trash without paying cost?",
        "reference": "[2]"
      },
      {
        "answer": "One \"Purple Lv.4 or lower Digimon card\" or \"Yellow Lv.4 or lower Digimon card\".",
        "question": "Which cards can be played by this card's [When Digivolving] effect?",
        "reference": "[3]"
      }
    ]
  },
