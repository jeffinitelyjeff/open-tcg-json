    "rulings": [
      {
        "answer": "Yes, it does.",
        "question": "Does this card's inherited effect apply even if my opponent only has 1 Digimon with no digivolution cards?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. Once that Digimon has no digivolution cards left, this card's inherited effect activates.",
        "question": "One of my Digimon has this card as a digivolution card and attacks one of my opponent's Digimon that has 1 digivolution card. If this Digimon has another When Attacking effect that activates and trashes that digivolution card, does this card's inherited effect activate?",
        "reference": "[1]"
      },
      {
        "answer": "No, it doesn't check Digimon in the breeding area.",
        "question": "Does this card's inherited effect apply if my opponent has a Digimon with no digivolution cards in their breeding area?",
        "reference": "[1]"
      },
      {
        "answer": "No, it doesn't. Your opponent has to have a Digimon in their battle area for it to activate.",
        "question": "Does this card's inherited effect apply when my opponent doesn't have any Digimon in their battle area?",
        "reference": "[1]"
      }
    ]
