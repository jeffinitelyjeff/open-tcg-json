  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=ST2-15#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for ST2-15 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No. This card's effect can only be used on Digimon cards that are digivolution cards. It can't be used on Digi-Egg cards or Tamer cards in a Digimon's digivolution cards.",
        "question": "Can I use the effect of this Option card to play a level 2 Digimon that is currently a digivolution card of one of my Digimon?",
        "reference": "[1]"
      },
      {
        "answer": "No. Since it is played as another Digimon, it is played unsuspended.",
        "question": "If I use this Option card's effect to play a digivolution card of one of my suspended Digimon, does it come into play suspended?",
        "reference": "[1]"
      },
      {
        "answer": "No. Since it is played as another Digimon, it is not affected by any effects of the original Digimon it was under.",
        "question": "If one of my Digimon has an effect applied to it that lasts a turn, then I use the effect of this Option card to play one of its digivolution cards as a Digimon, does that Digimon come into play with the same effect applied to it?",
        "reference": "[1]"
      },
      {
        "answer": "No, since it would count as the turn they were played.",
        "question": "Can Digimon played by this card's effect attack the turn they were played?",
        "reference": "[1]"
      }
    ]
  },
