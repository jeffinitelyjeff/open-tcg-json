  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT18-019#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT18-019 (Nov. 1, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't.  You can only return Digimon cards.",
        "question": "When DNA digivolving into this card and using this card's [On Play] [When Digivolving] effect to return 1 of each Digimon card with different levels from my opponent's trash to the top of the deck, can I return a Digi-Egg card to the top of the deck?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  You can only return Digimon cards with levels. You can't return a \"Lv.-\" Digimon card.",
        "question": "When DNA digivolving into this card and using this card's [On Play] [When Digivolving] effect to return 1 of each Digimon card with different levels from my opponent's trash to the top of the deck, can I return a Digimon card without a level to the top of the deck?",
        "reference": "[1]"
      },
      {
        "answer": "Yes. This card's digivolution cards are considered placed in the trash at the same time as deletion, therefore they can be placed at the bottom of the deck.",
        "question": "When using this card's [On Deletion] effect to return [Kimeramon] and [Machinedramon] from my trash to the bottom of my deck, can I return [Kimeramon] and [Machinedramon] that were in this card's digivolution cards to the bottom of the deck?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  A \"by doing X\" condition can't be met if only some of the required actions are performed.  In order for the conditions for this card's [On Deletion] effect to be met, you must return 1 [Kimeramon] and 1 [Machinedramon].",
        "question": "Can I use this card's [On Deletion] effect to return just 1 [Kimeramon] or 1 [Machinedramon] from my trash?",
        "reference": "[1]"
      }
    ]
  },
