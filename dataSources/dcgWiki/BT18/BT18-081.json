  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT18-081#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT18-081 (Nov. 1, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "Effects with the [Hand] icon can activate when their card is revealed from the hand.  This effect can activate during the main phase when you reveal this card from the hand and process the effect.",
        "question": "How do I activate this card's [Hand] [Main] effect?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  A \"by doing X\" condition can't be met if only some of the required actions are performed.  In order for the conditions for this card's [Hand] [Main] effect to be met, you must place 1 [Beetlemon] and 1 [MetalKabuterimon] under your Tamer.",
        "question": "Can I use this card's [Hand] [Main] effect to place just 1 [Beetlemon] or [MetalKabuterimon] from my trash under my Tamer?",
        "reference": "[1]"
      },
      {
        "answer": "No, it digivolves from the Tamer as-is.",
        "question": "Does this card's [Hand] [Main] effect where it can digivolve from a Tamer mean that the Tamer that will become a digivolution card is treated as a Digimon when it digivolves?",
        "reference": "[1]"
      },
      {
        "answer": "No, it isn't considered a Digimon that would digivolve.  When a Tamer would digivolve using this card's [Hand] [Main] effect, \"when a Digimon would digivolve\" effects don't trigger.",
        "question": "When a Tamer would digivolve using this card's [Hand] [Main] effect, is it considered a Digimon that would digivolve?",
        "reference": "[1]"
      },
      {
        "answer": "No, it isn't considered a Digimon that digivolves.  When a Tamer digivolves using this card's [Hand] [Main] effect, \"when a Digimon digivolves\" effects don't trigger.",
        "question": "When a Tamer digivolves using this card's [Hand] [Main] effect, is it considered a Digimon that digivolves?",
        "reference": "[1]"
      }
    ]
  },
