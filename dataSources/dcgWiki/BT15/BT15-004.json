  "rulings": {
    "references": [
      {
        "link": "https://world.digimoncard.com/rule/?card_no=BT15-004#qaResult_card",
        "num": 1,
        "text": "Official English Q&A for BT15-004 (Mar. 28, 2024)"
      }
    ],
    "rulings": [
      {
        "answer": "No, you can't.  This effect does not allow you to attack with Digimon that are in a state where they can't attack.",
        "question": "Can I use this card's inherited effect to attack using a Digimon with this card in its digivolution cards even when it's suspended?",
        "reference": "[1]"
      },
      {
        "answer": "No, you can't.  At the end of your turn, the inherited effects on these cards activate, the activation order is decided, and then the attack occurs for the 1st Digimon with this card in its digivolution cards. After activation of effects that are triggered upon attack declaration such as [When Attacking] effects and \"when one of your Digimon attacks\" effects but before the counter timing, the next activation would occur for the other inherited effect that was pending activation, but because the 1st Digimon is still attacking, you can't make a new attack declaration, and the 2nd Digimon's effect activation fails.",
        "question": "When I have 2 Digimon with this card in their digivolution cards, can I use this card's inherited effect to attack using these 2 Digimon at the end of my turn?",
        "reference": "[1]"
      }
    ]
  },
